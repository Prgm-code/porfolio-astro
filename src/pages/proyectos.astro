---
import Layout from "../layouts/Layout.astro";
import ProjectsArchive from "../components/ProjectsArchive.astro";
import { getUi } from "../i18n";

const lang = "es";
const ui = getUi(lang);
---

<Layout
  title={ui.meta.archiveTitle}
  description={ui.meta.archiveDescription}
  lang={lang}
>
  <ProjectsArchive lang={lang} />
</Layout>

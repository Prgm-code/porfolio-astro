---
import { ABOUT_DATA, EDUCATION, EXPERIENCE } from "../utils/data";
---

<section id="perfil" class="page-section">
  <div class="section-inner">
    <div class="profile-grid">
      <div class="profile-copy reveal">
        <div class="section-header">
          <span class="section-kicker">Perfil</span>
          <h2 class="section-title">
            Soluciones web con criterio técnico, estabilidad y visión de
            producto.
          </h2>
          <p class="section-copy">{ABOUT_DATA.summary}</p>
        </div>

        <dl class="profile-meta">
          <div class="profile-meta__item">
            <dt>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
              Formación
            </dt>
            <dd>Ingeniería Electrónica + Máster Full Stack</dd>
          </div>
          <div class="profile-meta__item">
            <dt>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Ubicación
            </dt>
            <dd>{ABOUT_DATA.location}</dd>
          </div>
          <div class="profile-meta__item">
            <dt>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              Disponibilidad
            </dt>
            <dd class="profile-meta__availability">
              {ABOUT_DATA.availability}
            </dd>
          </div>
        </dl>

        <ul class="profile-highlights">
          {ABOUT_DATA.highlights.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="profile-column reveal" data-delay="1">
        <div class="portrait-panel surface-panel">
          <div class="portrait-glow" aria-hidden="true"></div>
          <img src={ABOUT_DATA.image} alt="Patricio Gómez" />
          <div class="portrait-decoration" aria-hidden="true">
            <div class="portrait-decoration__ring"></div>
            <div class="portrait-decoration__dot"></div>
          </div>
        </div>

        <div class="credentials-block">
          <h3>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
            Formación
          </h3>
          <ul>
            {
              EDUCATION.map((item) => (
                <li>
                  <strong>{item.title}</strong>
                  <span>
                    {item.institution} · {item.year}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="experience-strip reveal" data-delay="2">
      <div class="experience-strip__header">
        <div class="experience-strip__kicker">
          <span class="section-kicker">Trayectoria</span>
          <div class="experience-strip__line" aria-hidden="true"></div>
        </div>
        <p class="section-copy experience-strip__copy">
          Desde telecomunicaciones aprendí las bases de redes, infraestructura e
          internet, junto con un fuerte enfoque al cliente. Hoy aplico esa
          experiencia al desarrollo de software para crear soluciones completas,
          estables y útiles.
        </p>
      </div>

      <div class="experience-list">
        {
          EXPERIENCE.map((item, index) => (
            <article class="experience-card">
              <div class="experience-card__year">{item.date}</div>
              <div class="experience-card__content">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <div class="experience-card__connector" aria-hidden="true">
                <div class="experience-card__dot" />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: clamp(3rem, 5vw, 5rem);
    align-items: start;
  }

  .profile-copy {
    display: grid;
    gap: 2rem;
  }

  .profile-copy .section-header {
    margin-bottom: 0;
  }

  .profile-meta {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .profile-meta__item {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .profile-meta__item:last-child {
    border-bottom: none;
  }

  .profile-meta dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.7rem;
    font-weight: 400;
  }

  .profile-meta dt svg {
    color: var(--color-accent);
    opacity: 0.7;
  }

  .profile-meta dd {
    margin: 0;
    color: var(--color-text);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .profile-meta__availability {
    color: var(--color-accent-strong) !important;
  }

  .profile-highlights {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profile-highlights li {
    padding-left: 1.4rem;
    position: relative;
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: 0.95rem;
  }

  .profile-highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      var(--color-accent),
      var(--color-accent-strong)
    );
    box-shadow: 0 0 8px rgba(212, 168, 83, 0.4);
  }

  .profile-column {
    display: grid;
    gap: 1.8rem;
  }

  .portrait-panel {
    position: relative;
    overflow: hidden;
    border-radius: 1.8rem;
    padding: 1.5rem;
  }

  .portrait-glow {
    position: absolute;
    inset: -50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(212, 168, 83, 0.15) 60deg,
      transparent 120deg
    );
    animation: portraitRotate 12s linear infinite;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes portraitRotate {
    to {
      transform: rotate(360deg);
    }
  }

  .portrait-panel img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1.2rem;
    filter: grayscale(20%);
    transition: filter var(--transition-slow);
  }

  .portrait-panel:hover img {
    filter: grayscale(0%);
  }

  .portrait-decoration {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    pointer-events: none;
  }

  .portrait-decoration__ring {
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(212, 168, 83, 0.3);
    border-radius: 50%;
    animation: ringPulse 3s ease-in-out infinite;
  }

  .portrait-decoration__dot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px rgba(212, 168, 83, 0.8);
  }

  @keyframes ringPulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.8;
    }
  }

  .credentials-block {
    display: grid;
    gap: 1.2rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 1.4rem;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.03),
      rgba(255, 255, 255, 0.01)
    );
  }

  .credentials-block h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
  }

  .credentials-block ul {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credentials-block li {
    display: grid;
    gap: 0.25rem;
  }

  .credentials-block strong {
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .credentials-block span {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  /* Experience strip */
  .experience-strip {
    margin-top: clamp(3.5rem, 6vw, 5.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .experience-strip__header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: 3rem;
    max-width: 50rem;
  }

  .experience-strip__kicker {
    display: flex;
    align-items: center;
    gap: 1rem;
    white-space: nowrap;
  }

  .experience-strip__line {
    width: 3rem;
    height: 1px;
    background: var(--color-accent);
    opacity: 0.4;
  }

  .experience-strip__copy {
    margin: 0;
  }

  .experience-list {
    display: grid;
    gap: 0;
    position: relative;
  }

  .experience-list::before {
    content: "";
    position: absolute;
    left: 7.5rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      var(--color-line) 10%,
      var(--color-line) 90%,
      transparent
    );
  }

  .experience-card {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 2rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background var(--transition-base);
  }

  .experience-card:last-child {
    border-bottom: none;
  }

  .experience-card:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .experience-card__year {
    font-size: 0.78rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-top: 0.15rem;
  }

  .experience-card__content {
    display: grid;
    gap: 0.4rem;
  }

  .experience-card__content h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .experience-card__content p {
    margin: 0.3rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: 0.9rem;
  }

  .experience-card__connector {
    display: flex;
    align-items: flex-start;
    padding-top: 0.35rem;
  }

  .experience-card__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    background: var(--color-bg);
    box-shadow: 0 0 8px rgba(212, 168, 83, 0.3);
    transition:
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  .experience-card:hover .experience-card__dot {
    background: var(--color-accent);
    box-shadow: 0 0 16px rgba(212, 168, 83, 0.6);
  }

  @media (max-width: 960px) {
    .profile-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .profile-column {
      order: -1;
    }

    .portrait-panel {
      max-width: 20rem;
      margin: 0 auto;
    }

    .profile-meta__item {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .experience-strip__header {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .experience-list::before {
      display: none;
    }

    .experience-card {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1.2rem 0;
    }

    .experience-card__connector {
      display: none;
    }
  }
</style>

<script>
  const profileObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          profileObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.14, rootMargin: "0px 0px -40px 0px" },
  );

  document.querySelectorAll("#perfil .reveal").forEach((element) => {
    profileObserver.observe(element);
  });
</script>

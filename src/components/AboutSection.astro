---
import { getData, getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const data = getData(lang);
---

<section id="perfil" class="page-section">
  <div class="section-inner">
    <header class="section-head reveal">
      <h2 class="section-title">{ui.about.title}</h2>
    </header>

    <div class="credentials reveal">
      <h3 class="credentials__heading label">
        {ui.about.educationHeading}
      </h3>
      <ul class="credentials__list">
        {
          data.education.map((item) => (
            <li class="credential">
              <strong class="credential__title">{item.title}</strong>
              <span class="credential__issuer">{item.institution}</span>
              <span class="credential__year">{item.year}</span>
              <ul class="credential__topics">
                {item.topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="credentials reveal">
      <h3 class="credentials__heading label">
        {ui.about.certificationsHeading}
      </h3>
      <ul class="credentials__list">
        {
          data.certifications.map((cert) => (
            <li class="credential">
              <strong class="credential__title">{cert.title}</strong>
              <span class="credential__issuer">{cert.area}</span>
              <span class="credential__year">{cert.year}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="credentials reveal">
      <h3 class="credentials__heading label">
        {ui.about.languagesHeading}
      </h3>
      <ul class="credentials__list">
        {
          data.languages.map((language) => (
            <li class="credential">
              <strong class="credential__title">{language.name}</strong>
              <span class="credential__issuer">{language.level}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Formación y certificaciones */
  .credentials + .credentials {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .credentials {
    display: grid;
    gap: 1rem;
  }

  .credentials__heading {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .credentials__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credential {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1.5rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-line);
  }

  .credential__title {
    font-weight: 500;
  }

  .credential__issuer {
    grid-row: 2;
    color: var(--color-text-soft);
    font-size: 0.9rem;
  }

  /* Contenidos del título: etiquetas en línea */
  .credential__topics {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .credential__topics li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .credential__year {
    grid-row: 1 / span 2;
    grid-column: 2;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-text-soft);
  }

  @media (min-width: 960px) {
    .credentials {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
    }

    .credentials__heading {
      grid-column: 1 / span 3;
      align-self: start;
      padding-top: 0.95rem;
      border-bottom: 0;
      border-top: 1px solid var(--color-line-strong);
    }

    .credentials__list {
      grid-column: 4 / span 9;
      border-top: 1px solid var(--color-line-strong);
    }

    .credential {
      grid-template-columns: repeat(9, minmax(0, 1fr));
      column-gap: var(--page-gutter);
      align-items: baseline;
    }

    .credential__title {
      grid-column: 1 / span 4;
    }

    .credential__issuer {
      grid-row: 1;
      grid-column: 5 / span 3;
    }

    .credential__year {
      grid-row: 1;
      grid-column: 8 / span 2;
      text-align: right;
    }

    .credential__topics {
      grid-row: 2;
      grid-column: 1 / span 7;
    }
  }
</style>

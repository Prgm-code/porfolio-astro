---
import { getData, getUi, type Lang } from "../i18n";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const data = getData(lang);
---

<section id="perfil" class="page-section">
  <div class="section-inner">
    <SectionHeader index="04" title={ui.about.title} />

    <div class="sheet">
      <div class="sheet-group reveal">
        <h3 class="sheet-group__title">{ui.about.educationHeading}</h3>
        <ul class="sheet-group__list">
          {
            data.education.map((item) => (
              <li class="sheet-row sheet-row--education">
                <strong class="sheet-row__title">{item.title}</strong>
                <span class="sheet-row__meta">{item.institution}</span>
                <span class="sheet-row__year">{item.year}</span>
                <ul class="sheet-row__topics">
                  {item.topics.map((topic) => (
                    <li>{topic}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="sheet-group reveal">
        <h3 class="sheet-group__title">{ui.about.certificationsHeading}</h3>
        <ul class="sheet-group__list">
          {
            data.certifications.map((cert) => (
              <li class="sheet-row">
                <strong class="sheet-row__title">{cert.title}</strong>
                <span class="sheet-row__meta">{cert.area}</span>
                <span class="sheet-row__year">{cert.year}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="sheet-group reveal">
        <h3 class="sheet-group__title">{ui.about.languagesHeading}</h3>
        <ul class="sheet-group__list">
          {
            data.languages.map((language) => (
              <li class="sheet-row">
                <strong class="sheet-row__title">{language.name}</strong>
                <span class="sheet-row__meta">{language.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .sheet {
    border-top: 1px solid var(--color-line);
  }

  .sheet-group {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.1rem 0.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .sheet-group__title {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sheet-group__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sheet-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.15rem 1.5rem;
    padding-block: 0.75rem;
  }

  .sheet-row + .sheet-row {
    border-top: 1px dashed var(--color-line);
  }

  .sheet-row__title {
    font-weight: 500;
  }

  .sheet-row__meta {
    grid-row: 2;
    font-size: 0.9rem;
    color: var(--color-text-soft);
  }

  .sheet-row__year {
    grid-row: 1 / span 2;
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-text-soft);
  }

  /* Contenidos del título: etiquetas en línea */
  .sheet-row__topics {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0.25rem;
    padding: 0;
    list-style: none;
  }

  .sheet-row__topics li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  @media (min-width: 960px) {
    .sheet-group {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
      padding-block: 0.35rem;
    }

    .sheet-group__title {
      grid-column: 1 / span 3;
      padding-top: 0.75rem;
    }

    .sheet-group__list {
      grid-column: 4 / span 9;
    }

    .sheet-row {
      grid-template-columns: repeat(9, minmax(0, 1fr));
      column-gap: var(--page-gutter);
      align-items: baseline;
    }

    .sheet-row__title {
      grid-column: 1 / span 4;
    }

    .sheet-row__meta {
      grid-row: 1;
      grid-column: 5 / span 3;
    }

    .sheet-row__year {
      grid-row: 1;
      grid-column: 8 / span 2;
      text-align: right;
    }

    .sheet-row__topics {
      grid-row: 2;
      grid-column: 1 / span 7;
    }
  }
</style>

---
import { Image } from "astro:assets";
import LinkIcon from "../icons/Link.svg?raw";
import { PROJECTS } from "../utils/data";

const featuredProjects = PROJECTS.filter((project) => project.featured).slice(
  0,
  6,
);

const isPortraitImage = (image: (typeof PROJECTS)[number]["images"][number]) =>
  typeof image !== "string" && image.height > image.width;
---

<section id="proyectos" class="page-section">
  <div class="section-inner">
    <div class="projects-header reveal">
      <div class="projects-header__left">
        <span class="section-kicker">Proyectos destacados</span>
        <h2 class="section-title">
          Aplicaciones funcionales con criterio técnico y una UI que sí acompaña.
        </h2>
      </div>
      <p class="projects-header__copy section-copy">
        Selección reciente de productos, plataformas internas y landings
        técnicas donde interfaz, lógica y operación conviven sin capas
        innecesarias.
      </p>
    </div>

    <div class="projects-list">
      {
        featuredProjects.map((project, index) => (
          <article
            class="project-card reveal"
            data-delay={String((index % 3) + 1)}
            style={`--card-index: ${index};`}
          >
            <div class="project-card__media-wrap">
              <a
                class="project-card__media browser-frame"
                href={project.link ?? "#contacto"}
                target={project.link ? "_blank" : undefined}
                rel={project.link ? "noopener noreferrer" : undefined}
                aria-label={`Abrir ${project.title}`}
              >
                <div
                  class="project-carousel"
                  data-project-carousel
                  data-slide-count={String(project.images.length)}
                >
                  {project.images.map((image, imageIndex) => (
                    <div
                      class:list={[
                        "project-carousel__slide",
                        imageIndex === 0 && "is-active",
                        isPortraitImage(image) && "is-portrait",
                      ]}
                      data-project-slide
                      aria-hidden={imageIndex === 0 ? "false" : "true"}
                    >
                      <Image
                        src={image}
                        alt={`Captura ${imageIndex + 1} del proyecto ${project.title}`}
                        class="project-card__image project-carousel__image"
                        widths={[720, 1080, 1600]}
                        sizes="(max-width: 960px) 100vw, 50vw"
                        loading={imageIndex === 0 ? "lazy" : "eager"}
                        format="webp"
                      />
                    </div>
                  ))}

                  {project.images.length > 1 && (
                    <div
                      class="project-carousel__dots"
                      aria-hidden="true"
                    >
                      {project.images.map((_, imageIndex) => (
                        <span
                          class:list={[
                            "project-carousel__dot",
                            imageIndex === 0 && "is-active",
                          ]}
                          data-project-dot
                        />
                      ))}
                    </div>
                  )}
                </div>

                <div class="project-card__hover-glow" aria-hidden="true" />
              </a>

              <div class="project-card__number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </div>
            </div>

            <div class="project-card__body">
              <div class="project-card__meta">
                <p class="project-card__label">{project.shortLabel}</p>
                <h3 class="project-card__title">{project.title}</h3>
                <p class="project-card__description">{project.description}</p>
              </div>

              <div class="project-card__details">
                <div class="project-card__stack">
                  <span class="project-card__detail-label">Stack</span>
                  <ul class="stack-list">
                    {project.tags.slice(0, 4).map((tag) => (
                      <li class="stack-chip">
                        <span class="stack-chip__icon" set:html={tag.icon} />
                        <span class="stack-chip__label">{tag.name}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-card__link"
                >
                  <span>Ver implementación</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"/>
                    <polyline points="7 7 17 7 17 17"/>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div class="projects-archive-cta reveal" data-delay="2">
      <a href="/proyectos" class="button-secondary projects-archive-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"/>
          <rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/>
          <rect x="3" y="14" width="7" height="7"/>
        </svg>
        Ver archivo completo
      </a>
    </div>
  </div>
</section>

<style>
  .projects-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(3rem, 5vw, 4rem);
  }

  .projects-header__left {
    display: grid;
    gap: 0.9rem;
  }

  .projects-header__copy {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    align-self: end;
  }

  .projects-list {
    display: grid;
    gap: clamp(2rem, 3.3vw, 3.2rem);
  }

  .project-card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-line);
    border-radius: 2rem;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.03),
      rgba(255, 255, 255, 0.01)
    );
    transition:
      transform var(--transition-slow),
      border-color var(--transition-base),
      box-shadow var(--transition-slow);
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(212, 168, 83, 0.3),
      transparent
    );
    opacity: 0;
    transition: opacity var(--transition-slow);
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(212, 168, 83, 0.2);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.3),
      0 0 40px rgba(212, 168, 83, 0.05);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  /* Alternate layout for odd cards */
  .project-card:nth-child(even) {
    grid-template-columns: 0.9fr 1.1fr;
  }

  .project-card:nth-child(even) .project-card__media-wrap {
    order: 2;
  }

  .project-card:nth-child(even) .project-card__body {
    order: 1;
  }

  .project-card__media-wrap {
    position: relative;
  }

  .project-card__media {
    display: block;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .project-card__media {
    transform: translateY(-4px);
  }

  .project-card__hover-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(212, 168, 83, 0.1) 0%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity var(--transition-slow);
    pointer-events: none;
  }

  .project-card:hover .project-card__hover-glow {
    opacity: 1;
  }

  .project-carousel {
    position: relative;
    width: 100%;
    aspect-ratio: 1.5 / 1;
    overflow: hidden;
  }

  .project-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.015);
    transition:
      opacity 420ms ease,
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-carousel__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .project-carousel__slide.is-portrait {
    background:
      radial-gradient(
        circle at center,
        rgba(212, 168, 83, 0.1),
        transparent 58%
      ),
      rgba(8, 10, 13, 0.38);
  }

  .project-carousel__slide.is-portrait .project-carousel__image {
    object-fit: contain;
    object-position: center;
  }

  .project-carousel__dots {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: flex;
    gap: 0.35rem;
    padding: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(8, 10, 13, 0.58);
    opacity: 0;
    transform: translateY(0.35rem);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
    backdrop-filter: blur(10px);
  }

  .project-card__media:hover .project-carousel__dots,
  .project-card__media:focus-visible .project-carousel__dots {
    opacity: 1;
    transform: translateY(0);
  }

  .project-carousel__dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: rgba(240, 235, 226, 0.35);
    transition:
      width var(--transition-base),
      background-color var(--transition-base);
  }

  .project-carousel__dot.is-active {
    width: 1rem;
    background: var(--color-accent);
  }

  .project-card__image {
    aspect-ratio: 1.5 / 1;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .project-card__image {
    transform: scale(1.03);
  }

  .project-card__number {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(212, 168, 83, 0.08);
    pointer-events: none;
    user-select: none;
    z-index: -1;
  }

  .project-card__body {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .project-card__meta {
    display: grid;
    gap: 0.6rem;
  }

  .project-card__label,
  .project-card__detail-label {
    color: var(--color-accent);
    font-size: 0.72rem;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .project-card__detail-label {
    display: block;
    margin-bottom: 0.5rem;
  }

  .project-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    background: linear-gradient(
      135deg,
      var(--color-text) 0%,
      var(--color-accent-strong) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .project-card__description {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: 0.95rem;
  }

  .project-card__details {
    display: grid;
    gap: 1.2rem;
    padding: 1.2rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    color: var(--color-accent-strong);
    font-size: 0.92rem;
    font-weight: 500;
    transition:
      gap var(--transition-base),
      color var(--transition-base);
  }

  .project-card__link:hover {
    gap: 0.9rem;
    color: var(--color-accent);
  }

  .project-card__link svg {
    transition: transform var(--transition-base);
  }

  .project-card__link:hover svg {
    transform: translate(2px, -2px);
  }

  .projects-archive-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(3rem, 5vw, 4rem);
  }

  .projects-archive-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 14rem;
  }

  @media (max-width: 960px) {
    .projects-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .project-card,
    .project-card:nth-child(even) {
      grid-template-columns: 1fr;
    }

    .project-card:nth-child(even) .project-card__media-wrap,
    .project-card:nth-child(even) .project-card__body {
      order: unset;
    }

    .project-card__number {
      font-size: 3.5rem;
    }
  }
</style>

<script>
  const projectObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          projectObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: "0px 0px -60px 0px" },
  );

  document.querySelectorAll("#proyectos .reveal").forEach((element) => {
    projectObserver.observe(element);
  });

  const carouselTimers = new WeakMap();

  document
    .querySelectorAll("[data-project-carousel]")
    .forEach((carousel) => {
      const slides = Array.from(
        carousel.querySelectorAll("[data-project-slide]"),
      );
      const dots = Array.from(carousel.querySelectorAll("[data-project-dot]"));
      const media = carousel.closest(".project-card__media");
      let activeIndex = 0;

      function setActiveSlide(index) {
        activeIndex = index;

        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === activeIndex;
          slide.classList.toggle("is-active", isActive);
          slide.setAttribute("aria-hidden", String(!isActive));
        });

        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle("is-active", dotIndex === activeIndex);
        });
      }

      function startCarousel() {
        if (slides.length < 2) return;
        stopCarousel();
        carouselTimers.set(
          carousel,
          window.setInterval(() => {
            setActiveSlide((activeIndex + 1) % slides.length);
          }, 1100),
        );
      }

      function stopCarousel() {
        const timer = carouselTimers.get(carousel);
        if (timer) {
          window.clearInterval(timer);
          carouselTimers.delete(carousel);
        }

        setActiveSlide(0);
      }

      media?.addEventListener("mouseenter", startCarousel);
      media?.addEventListener("focusin", startCarousel);
      media?.addEventListener("mouseleave", stopCarousel);
      media?.addEventListener("focusout", stopCarousel);
    });
</script>

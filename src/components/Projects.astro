---
import { Image } from "astro:assets";
import { getProjects, getUi, localePath, type Lang } from "../i18n";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const projects = getProjects(lang);

const featuredProjects = projects
  .filter((project) => project.featured)
  .slice(0, 6);

const pad = (value: number) => String(value).padStart(2, "0");

const isPortraitImage = (image: (typeof projects)[number]["images"][number]) =>
  typeof image !== "string" && image.height > image.width;

const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<section id="proyectos" class="page-section">
  <div class="section-inner">
    <SectionHeader index="01" title={ui.projects.title}>
      <span>{ui.projects.count(featuredProjects.length, projects.length)}</span>
    </SectionHeader>

    <div class="showcase" data-showcase>
      <ol class="showcase__list" aria-label={ui.projects.regionLabel}>
        {
          featuredProjects.map((project, index) => (
            <li
              class:list={["showcase__item", index === 0 && "is-active"]}
              data-showcase-item
              data-index={index}
              data-title={project.title}
            >
              <article class="entry reveal">
                {project.image && (
                  <div class="entry__media browser-frame">
                    <Image
                      src={project.image}
                      alt={ui.projects.screenshotAlt(1, project.title)}
                      class="entry__image"
                      widths={[480, 720, 1080]}
                      sizes="100vw"
                      loading="lazy"
                      format="webp"
                    />
                  </div>
                )}

                <p class="entry__index" aria-hidden="true">
                  {pad(index + 1)}
                </p>
                <h3 class="entry__title">{project.title}</h3>
                <p class="entry__label">{project.shortLabel}</p>
                <p class="entry__description">{project.description}</p>

                <ul class="stack-list" aria-label="Stack">
                  {project.tags.map((tag) => (
                    <li class="stack-chip">
                      <span
                        class="stack-chip__icon"
                        aria-hidden="true"
                        set:html={tag.icon}
                      />
                      <span class="stack-chip__label">{tag.name}</span>
                    </li>
                  ))}
                </ul>

                <div class="entry__links">
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="arrow-link entry__site"
                    >
                      {hostname(project.link)}
                      <svg
                        aria-hidden="true"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="square"
                      >
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                    </a>
                  )}
                  {project.caseStudy && (
                    <a
                      href={localePath(lang, project.caseStudy)}
                      class="arrow-link"
                    >
                      {ui.projects.caseStudy}
                      <svg
                        aria-hidden="true"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="square"
                      >
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </a>
                  )}
                </div>
              </article>
            </li>
          ))
        }
      </ol>

      <!-- Visor de escritorio: repite las capturas de la lista, por eso se
           oculta a lectores de pantalla y queda fuera del orden de tabulación. -->
      <div class="showcase__viewer reveal" aria-hidden="true">
        <div class="viewer">
          <span class="viewer__mark viewer__mark--tl"></span>
          <span class="viewer__mark viewer__mark--tr"></span>
          <span class="viewer__mark viewer__mark--bl"></span>
          <span class="viewer__mark viewer__mark--br"></span>

          {
            featuredProjects.map((project, index) => (
              <a
                class:list={[
                  "viewer__layer browser-frame",
                  index === 0 && "is-active",
                ]}
                href={project.link ?? localePath(lang, "/proyectos")}
                target={project.link ? "_blank" : undefined}
                rel={project.link ? "noopener noreferrer" : undefined}
                tabindex="-1"
                inert={index === 0 ? undefined : true}
                data-viewer-layer
                data-project-carousel-trigger
              >
                <div class="project-carousel" data-project-carousel>
                  {project.images.map((image, imageIndex) => (
                    <div
                      class:list={[
                        "project-carousel__slide",
                        imageIndex === 0 && "is-active",
                        isPortraitImage(image) && "is-portrait",
                      ]}
                      data-project-slide
                    >
                      <Image
                        src={image}
                        alt=""
                        class="project-carousel__image"
                        widths={[720, 1080, 1600]}
                        sizes="(max-width: 1023px) 100vw, 56vw"
                        loading="lazy"
                        format="webp"
                      />
                    </div>
                  ))}

                  {project.images.length > 1 && (
                    <div class="project-carousel__dots">
                      {project.images.map((_, imageIndex) => (
                        <span
                          class:list={[
                            "project-carousel__dot",
                            imageIndex === 0 && "is-active",
                          ]}
                          data-project-dot
                        />
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))
          }
        </div>

        <div class="viewer__caption">
          <span class="viewer__count">
            <span data-viewer-count>01</span> / {pad(featuredProjects.length)}
          </span>
          <span class="viewer__bars">
            {
              featuredProjects.map((_, index) => (
                <span
                  class:list={["viewer__bar", index === 0 && "is-active"]}
                  data-viewer-bar
                />
              ))
            }
          </span>
          <span class="viewer__title" data-viewer-title>
            {featuredProjects[0]?.title}
          </span>
        </div>
      </div>
    </div>

    <div class="work-archive reveal">
      <a href={localePath(lang, "/proyectos")} class="arrow-link">
        {ui.projects.archiveCta(projects.length)}
        <svg
          aria-hidden="true"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .showcase__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Ficha de cada proyecto */
  .entry {
    position: relative;
    display: grid;
    gap: 0.7rem;
    align-content: start;
    padding-block: 2rem 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .showcase__item:first-child .entry {
    padding-top: 0.5rem;
  }

  .entry__media {
    margin-bottom: 0.75rem;
    aspect-ratio: 16 / 10;
  }

  .entry__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .entry__index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    transition: color 300ms var(--ease-out);
  }

  .entry__title {
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    transition: color 300ms var(--ease-out);
  }

  .entry__label {
    font-weight: 500;
  }

  .entry__description {
    max-width: 52ch;
    color: var(--color-text-muted);
  }

  .entry .stack-list {
    margin-top: 0.35rem;
  }

  .entry__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 0.6rem;
  }

  .entry__site {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 400;
  }

  /* Sin JavaScript: grilla de dos columnas, cada ficha con su captura */
  @media (min-width: 1024px) {
    :global(html:not(.js)) .showcase__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--page-gutter);
    }

    :global(html:not(.js)) .showcase__item:first-child .entry {
      padding-top: 2rem;
    }
  }

  /* Visor (solo escritorio con JavaScript) */
  .showcase__viewer {
    display: none;
  }

  @media (min-width: 1024px) {
    :global(.js) .showcase {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
      align-items: start;
    }

    :global(.js) .showcase__list {
      grid-column: 1 / span 5;
    }

    :global(.js) .showcase__viewer {
      display: grid;
      gap: 1rem;
      grid-column: 6 / span 7;
      position: sticky;
      top: calc(var(--header-height) + 2.5rem);
      padding: 0.75rem 0 0 0.75rem;
    }

    :global(.js) .entry__media {
      display: none;
    }

    :global(.js) .entry {
      min-height: clamp(17rem, 42vh, 24rem);
      padding-left: 1.5rem;
    }

    /* Marca de la ficha activa */
    :global(.js) .entry::before {
      content: "";
      position: absolute;
      left: 0;
      top: 2rem;
      bottom: 2.5rem;
      width: 2px;
      background: var(--color-accent);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 500ms var(--ease-out);
    }

    :global(.js) .showcase__item:first-child .entry::before {
      top: 0.5rem;
    }

    :global(.js) .showcase__item.is-active .entry::before {
      transform: scaleY(1);
    }

    :global(.js) .showcase__item:not(.is-active) .entry__index {
      color: var(--color-text-soft);
    }

    :global(.js) .showcase__item:not(.is-active) .entry__title {
      color: var(--color-text-soft);
    }
  }

  .viewer {
    position: relative;
    aspect-ratio: 16 / 10;
  }

  /* Marcas de corte en las esquinas del visor */
  .viewer__mark {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    border: 0 solid var(--color-text-soft);
  }

  .viewer__mark--tl {
    top: -0.75rem;
    left: -0.75rem;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .viewer__mark--tr {
    top: -0.75rem;
    right: -0.75rem;
    border-top-width: 1px;
    border-right-width: 1px;
  }

  .viewer__mark--bl {
    bottom: -0.75rem;
    left: -0.75rem;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }

  .viewer__mark--br {
    bottom: -0.75rem;
    right: -0.75rem;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .viewer__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 450ms var(--ease-out),
      visibility 0s linear 450ms;
  }

  .viewer__layer.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 450ms var(--ease-out),
      visibility 0s;
  }

  .viewer__layer .project-carousel {
    height: 100%;
    aspect-ratio: auto;
  }

  .viewer__layer.is-active .project-carousel__image {
    animation: viewer-settle 900ms var(--ease-out);
  }

  /* Solo se cargan las capturas extra del proyecto activo */
  .viewer__layer:not(.is-active) .project-carousel__slide:not(:first-child) {
    display: none;
  }

  @keyframes viewer-settle {
    from {
      transform: scale(1.03);
    }
  }

  .viewer__caption {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-soft);
  }

  .viewer__count {
    font-variant-numeric: tabular-nums;
  }

  .viewer__count span {
    color: var(--color-ink);
  }

  .viewer__bars {
    display: flex;
    gap: 4px;
  }

  .viewer__bar {
    width: 1.1rem;
    height: 2px;
    background: var(--color-line);
    transition: background-color 300ms var(--ease-out);
  }

  .viewer__bar.is-active {
    background: var(--color-accent);
  }

  .viewer__title {
    margin-left: auto;
    color: var(--color-text);
  }

  .work-archive {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-strong);
  }
</style>

<script>
  import { initProjectCarousels } from "../scripts/project-carousels";

  initProjectCarousels();

  // El visor muestra el proyecto que cruza la mitad de la pantalla.
  const showcase = document.querySelector<HTMLElement>("[data-showcase]");

  if (showcase) {
    const items = Array.from(
      showcase.querySelectorAll<HTMLElement>("[data-showcase-item]"),
    );
    const layers = Array.from(
      showcase.querySelectorAll<HTMLElement>("[data-viewer-layer]"),
    );
    const bars = Array.from(
      showcase.querySelectorAll<HTMLElement>("[data-viewer-bar]"),
    );
    const count = showcase.querySelector<HTMLElement>("[data-viewer-count]");
    const title = showcase.querySelector<HTMLElement>("[data-viewer-title]");
    let active = 0;
    let pending = 0;

    const setActive = (index: number) => {
      if (index === active) return;
      active = index;
      items.forEach((item, i) =>
        item.classList.toggle("is-active", i === index),
      );
      layers.forEach((layer, i) => {
        const isActive = i === index;
        layer.classList.toggle("is-active", isActive);
        layer.inert = !isActive;
      });
      bars.forEach((bar, i) => bar.classList.toggle("is-active", i === index));
      if (count) count.textContent = String(index + 1).padStart(2, "0");
      if (title) title.textContent = items[index]?.dataset.title ?? "";
    };

    // Un retraso corto evita cambios en cadena al hacer scroll rápido.
    const schedule = (index: number) => {
      window.clearTimeout(pending);
      pending = window.setTimeout(() => setActive(index), 90);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            schedule(Number((entry.target as HTMLElement).dataset.index));
          }
        });
      },
      { rootMargin: "-45% 0px -54% 0px" },
    );

    items.forEach((item, index) => {
      observer.observe(item);
      item.addEventListener("focusin", () => setActive(index));
    });
  }
</script>

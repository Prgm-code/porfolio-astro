---
import { Image } from "astro:assets";
import { getProjects, getUi, localePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const projects = getProjects(lang);

const featuredProjects = projects
  .filter((project) => project.featured)
  .slice(0, 6);

const isPortraitImage = (image: (typeof projects)[number]["images"][number]) =>
  typeof image !== "string" && image.height > image.width;

const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<section id="proyectos" class="page-section">
  <div class="section-inner">
    <header class="section-head reveal">
      <h2 class="section-title">{ui.projects.title}</h2>
      <p class="section-meta">
        {ui.projects.count(featuredProjects.length, projects.length)}
      </p>
    </header>

    <div
      class="work reveal"
      data-carousel
      role="region"
      aria-label={ui.projects.regionLabel}
    >
      <div
        class="work__list"
        role="group"
        aria-label={ui.projects.listLabel}
        data-carousel-list
      >
        {
          featuredProjects.map((project, index) => (
            <button
              type="button"
              class:list={["work__item", index === 0 && "is-active"]}
              data-carousel-dot
              data-index={index}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span class="work__name">{project.title}</span>
              <span class="work__hint">{project.shortLabel}</span>
            </button>
          ))
        }
      </div>

      <div class="work__stage">
        {
          featuredProjects.map((project, index) => (
            <article
              class:list={["work__slide", index === 0 && "is-active"]}
              data-slide
              data-project-key={project.key}
              aria-hidden={index === 0 ? "false" : "true"}
              inert={index === 0 ? undefined : true}
            >
              <a
                class="work__media browser-frame"
                href={project.link ?? "#contacto"}
                target={project.link ? "_blank" : undefined}
                rel={project.link ? "noopener noreferrer" : undefined}
                aria-label={ui.projects.openProject(project.title)}
                data-project-carousel-trigger
              >
                <div class="project-carousel" data-project-carousel>
                  {project.images.map((image, imageIndex) => (
                    <div
                      class:list={[
                        "project-carousel__slide",
                        imageIndex === 0 && "is-active",
                        isPortraitImage(image) && "is-portrait",
                      ]}
                      data-project-slide
                      aria-hidden={imageIndex === 0 ? "false" : "true"}
                      inert={imageIndex === 0 ? undefined : true}
                    >
                      <Image
                        src={image}
                        alt={ui.projects.screenshotAlt(
                          imageIndex + 1,
                          project.title,
                        )}
                        class="project-carousel__image"
                        widths={[720, 1080, 1600]}
                        sizes="(max-width: 960px) 100vw, 64vw"
                        loading={index === 0 ? "eager" : "lazy"}
                        format="webp"
                      />
                    </div>
                  ))}

                  {project.images.length > 1 && (
                    <div class="project-carousel__dots" aria-hidden="true">
                      {project.images.map((_, imageIndex) => (
                        <span
                          class:list={[
                            "project-carousel__dot",
                            imageIndex === 0 && "is-active",
                          ]}
                          data-project-dot
                        />
                      ))}
                    </div>
                  )}
                </div>
              </a>

              <div class="work__detail">
                <div class="work__heading">
                  <h3 class="work__title">{project.title}</h3>
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="arrow-link work__link"
                    >
                      {hostname(project.link)}
                      <svg
                        aria-hidden="true"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="square"
                      >
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                    </a>
                  )}
                </div>

                <p class="work__description">{project.description}</p>

                <ul class="stack-list" aria-label="Stack">
                  {project.tags.map((tag) => (
                    <li class="stack-chip">
                      <span
                        class="stack-chip__icon"
                        aria-hidden="true"
                        set:html={tag.icon}
                      />
                      <span class="stack-chip__label">{tag.name}</span>
                    </li>
                  ))}
                </ul>

                {project.caseStudy && (
                  <a
                    href={localePath(lang, project.caseStudy)}
                    class="arrow-link work__case"
                  >
                    {ui.projects.caseStudy}
                    <svg
                      aria-hidden="true"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="work-archive reveal">
      <a href={localePath(lang, "/proyectos")} class="arrow-link">
        {ui.projects.archiveCta(projects.length)}
        <svg
          aria-hidden="true"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .work {
    display: grid;
    gap: 1.5rem;
  }

  /* Lista de proyectos: chips con scroll en móvil, índice vertical en escritorio */
  .work__list {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--page-gutter) * -1);
    padding-inline: var(--page-gutter);
  }

  .work__list::-webkit-scrollbar {
    display: none;
  }

  .work__item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-shrink: 0;
    min-height: 2.75rem;
    padding: 0.55rem 0.85rem;
    background: transparent;
    border: 1px solid var(--color-line);
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.92rem;
    text-align: left;
    cursor: pointer;
    transition:
      color var(--transition-base),
      background-color var(--transition-base),
      border-color var(--transition-base),
      padding var(--transition-base);
  }

  .work__hint {
    display: none;
  }

  .work__item:hover {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .work__item.is-active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  /* Escenario */
  .work__stage {
    display: grid;
  }

  .work__slide {
    grid-area: 1 / 1;
    display: grid;
    gap: 1.75rem;
    align-content: start;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out),
      visibility 0s linear 420ms;
  }

  .work__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out),
      visibility 0s;
  }

  .work__detail {
    display: grid;
    gap: 1.25rem;
  }

  .work__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .work__title {
    font-size: clamp(1.35rem, 2vw, 1.625rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .work__link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 400;
  }

  .work__case {
    justify-self: start;
  }

  .work__description {
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  @media (min-width: 960px) {
    .work {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
      align-items: start;
    }

    .work__list {
      grid-column: 1 / span 3;
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 0;
      overflow: visible;
      border-top: 1px solid var(--color-line-strong);
    }

    .work__item {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.15rem;
      width: 100%;
      padding: 0.9rem 0.25rem;
      border: 0;
      border-bottom: 1px solid var(--color-line);
      font-size: 1.02rem;
    }

    .work__hint {
      display: block;
      font-size: 0.8rem;
      line-height: 1.35;
      color: var(--color-text-soft);
    }

    .work__item:hover {
      padding-left: 0.75rem;
      background: transparent;
    }

    .work__item.is-active {
      background: transparent;
      border-bottom-color: var(--color-line);
      color: var(--color-ink);
      font-weight: 600;
      padding-left: 0.75rem;
      box-shadow: inset 2px 0 0 var(--color-accent);
    }

    .work__item.is-active .work__hint {
      font-weight: 400;
    }

    .work__stage {
      grid-column: 4 / span 9;
    }
  }

  .work-archive {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-strong);
  }
</style>

<script>
  import { initProjectCarousels } from "../scripts/project-carousels";

  initProjectCarousels();

  const work = document.querySelector<HTMLElement>(
    "#proyectos [data-carousel]",
  );
  const slides = Array.from(
    work?.querySelectorAll<HTMLElement>("[data-slide]") ?? [],
  );
  const items = Array.from(
    work?.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]") ?? [],
  );

  function setActive(nextIndex: number) {
    slides.forEach((slide, index) => {
      const isActive = index === nextIndex;
      slide.classList.toggle("is-active", isActive);
      slide.setAttribute("aria-hidden", String(!isActive));
      slide.inert = !isActive;
    });

    items.forEach((item, index) => {
      const isActive = index === nextIndex;
      item.classList.toggle("is-active", isActive);
      item.setAttribute("aria-pressed", String(isActive));
    });

    // En móvil, mantener visible el chip activo.
    items[nextIndex]?.scrollIntoView({ block: "nearest", inline: "nearest" });
  }

  items.forEach((item, index) => {
    item.addEventListener("click", () => setActive(index));
    item.addEventListener("keydown", (event) => {
      const step =
        event.key === "ArrowDown" || event.key === "ArrowRight"
          ? 1
          : event.key === "ArrowUp" || event.key === "ArrowLeft"
            ? -1
            : 0;
      if (!step) return;
      event.preventDefault();
      const next = (index + step + items.length) % items.length;
      setActive(next);
      items[next]?.focus();
    });
  });
</script>

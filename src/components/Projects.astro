---
import { PROJECTS } from "../utils/data";
import LinkIcon from "../icons/Link.svg?raw";
import { Image } from "astro:assets";
---

<section id="proyects" class="py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <h2 class="section-title animate">Mi Portafolio</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        PROJECTS.slice(0, 6).map(({ title, description, tags, image, images, link }, index) => (
          <article 
            class={`glass-card overflow-hidden group animate animate-delay-${(index % 3 + 1) * 100}`}
          >
            <!-- Image Container -->
            <div class="relative h-48 overflow-hidden">
              {images && images.length > 1 ? (
                <div
                  id={`carousel-${title.replace(/\s+/g, '-').toLowerCase()}`}
                  class="relative w-full h-full cursor-pointer"
                >
                  {images.map((img, imgIndex) => (
                    <div
                      class={`absolute inset-0 transition-opacity duration-500 ${
                        imgIndex === 0 ? 'opacity-100' : 'opacity-0'
                      }`}
                      style={`z-index: ${10 - imgIndex};`}
                    >
                      <img
                        src={typeof img === 'object' ? img.src : img}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                        alt={`${title} - Imagen ${imgIndex + 1}`}
                        loading="lazy"
                      />
                    </div>
                  ))}

                  <!-- Indicators -->
                  <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-20 opacity-0 group-hover:opacity-100 transition-opacity">
                    {images.map((_, idx) => (
                      <div
                        class={`w-1.5 h-1.5 rounded-full transition-colors ${
                          idx === 0 ? 'bg-[var(--color-primary)]' : 'bg-white/50'
                        }`}
                        data-slide-index={idx}
                      />
                    ))}
                  </div>

                  <!-- Progress bar -->
                  <div class="absolute bottom-0 left-0 w-full h-0.5 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity z-20">
                    <div class="progress-bar h-full bg-[var(--color-primary)] w-0 transition-all" />
                  </div>
                </div>
              ) : (
                <img 
                  src={typeof image === 'object' ? image.src : image}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  alt={`Captura de proyecto ${title}`}
                  loading="lazy"
                />
              )}

              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)] via-transparent to-transparent opacity-60" />
              
              <!-- Icon overlay on hover -->
              <div class="absolute inset-0 bg-[var(--color-primary)]/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                {link && (
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-12 h-12 rounded-full bg-[var(--color-primary)] flex items-center justify-center transform scale-0 group-hover:scale-100 transition-transform duration-300"
                  >
                    <span class="w-5 h-5 text-[var(--color-bg)] flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={LinkIcon} />
                  </a>
                )}
              </div>
            </div>

            <!-- Content -->
            <div class="p-5">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-lg font-semibold text-white line-clamp-1">
                  {title}
                </h3>
                {link && (
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--color-primary)] hover:text-[var(--color-primary-light)] transition-colors"
                    title="Ver proyecto"
                  >
                    <span class="w-4 h-4 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={LinkIcon} />
                  </a>
                )}
              </div>

              <p class="text-[var(--color-text-secondary)] text-sm mb-4 line-clamp-2">
                {description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {tags.slice(0, 3).map((tag) => (
                  <span class="flex items-center gap-1.5 text-xs py-1 px-2.5 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] border border-[var(--color-primary)]/20">
                    <span class="w-3 h-3 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={tag.icon} />
                    {tag.name}
                  </span>
                ))}
              </div>

              {link && (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-flex items-center text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-light)] transition-colors"
                >
                  Ver Proyecto
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  }, observerOptions);

  document.querySelectorAll('#proyects .animate').forEach(el => {
    observer.observe(el);
  });

  // Carousel functionality
  document.addEventListener('DOMContentLoaded', function () {
    const carousels = document.querySelectorAll('[id^="carousel-"]');

    carousels.forEach(carousel => {
      const imageContainers = carousel.querySelectorAll('div[class*="absolute inset-0"]');
      const indicators = carousel.querySelectorAll('[data-slide-index]');

      if (imageContainers.length <= 1) return;

      let currentIndex = 0;

      function showSlide(index: number) {
        imageContainers.forEach((container, i) => {
          if (i === index) {
            container.classList.remove('opacity-0');
            container.classList.add('opacity-100');
          } else {
            container.classList.remove('opacity-100');
            container.classList.add('opacity-0');
          }
        });

        indicators.forEach((indicator, i) => {
          if (i === index) {
            indicator.classList.remove('bg-white/50');
            indicator.classList.add('bg-[var(--color-primary)]');
          } else {
            indicator.classList.remove('bg-[var(--color-primary)]');
            indicator.classList.add('bg-white/50');
          }
        });
      }

      function nextSlide() {
        currentIndex = (currentIndex + 1) % imageContainers.length;
        showSlide(currentIndex);
        setTimeout(() => startProgressBar(carousel), 500);
      }

      function startProgressBar(carouselElement: Element) {
        const progressBar = carouselElement.querySelector('.progress-bar') as HTMLElement;
        if (!progressBar) return;

        let startTime = Date.now();
        const duration = 1500;

        function animate() {
          const elapsed = Date.now() - startTime;
          const progress = Math.min((elapsed / duration) * 100, 100);
          progressBar.style.width = `${progress}%`;
          if (progress < 100) requestAnimationFrame(animate);
        }

        progressBar.style.width = '0%';
        startTime = Date.now();
        animate();
      }

      carousel.addEventListener('mouseenter', () => {
        const interval = setInterval(nextSlide, 2000);
        (carousel as any)['carouselInterval'] = interval;
        setTimeout(() => startProgressBar(carousel), 500);
      });

      carousel.addEventListener('mouseleave', () => {
        if ((carousel as any)['carouselInterval']) {
          clearInterval((carousel as any)['carouselInterval']);
          delete (carousel as any)['carouselInterval'];
        }
        const progressBar = carousel.querySelector('.progress-bar') as HTMLElement;
        if (progressBar) progressBar.style.width = '0%';
        setTimeout(() => {
          currentIndex = 0;
          showSlide(currentIndex);
        }, 500);
      });

      showSlide(0);
    });
  });
</script>

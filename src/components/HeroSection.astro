---
import { getData, type Lang } from "../i18n";
import DeployPipeline from "./DeployPipeline.astro";
import GitHubIcon from "../icons/GitHub.svg?raw";
import LinkedInIcon from "../icons/LinkedIn.svg?raw";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { hero, about, social } = getData(lang);

const profiles = [
  { label: "LinkedIn", href: social.linkedin, icon: LinkedInIcon },
  { label: "GitHub", href: social.github, icon: GitHubIcon },
];
---

<section id="hero" class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1 class="hero-name reveal">{hero.name}</h1>
      <p class="hero-role reveal">
        {hero.role} · {about.location}
      </p>
      <p class="hero-support reveal">{hero.supportingText}</p>

      <div class="hero-actions reveal">
        <a href={hero.cta.href} class="button-primary">
          {hero.cta.label}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            aria-hidden="true"
          >
            <path d="M12 5v14M6 13l6 6 6-6"></path>
          </svg>
        </a>
        {
          profiles.map((profile) => (
            <a
              href={profile.href}
              target="_blank"
              rel="noopener noreferrer"
              class="button-secondary hero-profile"
            >
              <span
                class="hero-profile__icon"
                aria-hidden="true"
                set:html={profile.icon}
              />
              {profile.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero-visual reveal">
      <DeployPipeline lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 8vw, 6.5rem);
  }

  .hero-inner {
    width: min(100% - var(--page-gutter) * 2, var(--content-width));
    margin-inline: auto;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .hero-name {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .hero-role {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  .hero-support {
    max-width: 58ch;
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  @media (max-width: 479px) {
    .hero-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-actions .button-primary {
      grid-column: 1 / -1;
    }
  }

  .hero-profile__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    transition: transform var(--transition-base);
  }

  .hero-profile__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .hero-profile:hover .hero-profile__icon {
    transform: translateY(-1px);
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
    }

    .hero-copy {
      grid-column: 1 / span 6;
    }

    .hero-visual {
      grid-column: 8 / span 5;
    }
  }
</style>

---
import GitHubIcon from "../icons/GitHub.svg?raw";
import LinkedInIcon from "../icons/LinkedIn.svg?raw";
import MailIcon from "../icons/Mail.svg?raw";
import WhatsAppIcon from "../icons/WhatsApp.svg?raw";
import { HERO_DATA } from "../utils/data";
---

<section id="hero" class="min-h-screen flex items-center px-4 sm:px-6 lg:px-8 py-24 lg:py-0">
  <div class="max-w-6xl mx-auto w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text Column -->
      <div class="order-2 lg:order-1 text-center lg:text-left">
        <!-- Greeting -->
        <p class="animate text-[var(--color-text-secondary)] text-sm md:text-base mb-3 uppercase tracking-widest">
          {HERO_DATA.greeting}
        </p>

        <!-- Name -->
        <h1 class="animate animate-delay-100 text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
          {HERO_DATA.name}
        </h1>

        <!-- Title with gradient -->
        <h2 class="animate animate-delay-200 text-xl md:text-2xl lg:text-3xl font-semibold mb-6">
          <span class="text-white">Y soy </span>
          <span class="bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">
            {HERO_DATA.title}
          </span>
        </h2>

        <!-- Description -->
        <p class="animate animate-delay-300 text-[var(--color-text-secondary)] text-base md:text-lg max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed">
          {HERO_DATA.description}
        </p>

        <!-- Social Icons -->
        <div class="animate animate-delay-400 flex justify-center lg:justify-start gap-3 mb-8">
          {HERO_DATA.social.github && (
            <a
              href={HERO_DATA.social.github}
              target="_blank" 
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-card-border)] bg-[var(--color-card)] hover:border-[var(--color-primary)] hover:bg-[var(--color-card-hover)] transition-all duration-300 hover:scale-110"
              aria-label="GitHub"
            >
              <span class="w-5 h-5 text-white flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={GitHubIcon} />
            </a>
          )}
          {HERO_DATA.social.linkedin && (
            <a
              href={HERO_DATA.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-card-border)] bg-[var(--color-card)] hover:border-[var(--color-primary)] hover:bg-[var(--color-card-hover)] transition-all duration-300 hover:scale-110"
              aria-label="LinkedIn"
            >
              <span class="w-5 h-5 text-white flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={LinkedInIcon} />
            </a>
          )}
          {HERO_DATA.social.email && (
            <a
              href={`mailto:${HERO_DATA.social.email}`}
              class="w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-card-border)] bg-[var(--color-card)] hover:border-[var(--color-primary)] hover:bg-[var(--color-card-hover)] transition-all duration-300 hover:scale-110"
              aria-label="Email"
            >
              <span class="w-5 h-5 text-white flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={MailIcon} />
            </a>
          )}
          {HERO_DATA.social.whatsapp && (
            <a
              href={HERO_DATA.social.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-card-border)] bg-[var(--color-card)] hover:border-[var(--color-primary)] hover:bg-[var(--color-card-hover)] transition-all duration-300 hover:scale-110"
              aria-label="WhatsApp"
            >
              <span class="w-5 h-5 text-white flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={WhatsAppIcon} />
            </a>
          )}
        </div>

        <!-- CTA Button -->
        <div class="animate animate-delay-500">
          <a
            href="#about"
            class="btn-primary inline-flex items-center gap-2 text-sm md:text-base"
          >
            Leer Más
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Image Column -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end animate-scale">
        <div class="relative">
          <!-- Glow effect behind image -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-cyan-500/30 to-blue-600/20 blur-2xl scale-110"></div>
          
          <!-- Main image -->
          <div class="relative">
            <img
              src={HERO_DATA.image}
              alt={`Foto de ${HERO_DATA.name}`}
              class="w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 rounded-full object-cover border-4 border-[var(--color-primary)]/50 shadow-2xl glow-pulse"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  }, observerOptions);

  document.querySelectorAll('#hero .animate, #hero .animate-scale').forEach(el => {
    observer.observe(el);
  });
</script>

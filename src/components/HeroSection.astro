---
import { getData, getProjects, getUi, localePath, type Lang } from "../i18n";
import DeployPipeline from "./DeployPipeline.astro";
import GitHubIcon from "../icons/GitHub.svg?raw";
import LinkedInIcon from "../icons/LinkedIn.svg?raw";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const { hero, about, social } = getData(lang);
const caseProject = getProjects(lang).find((project) => project.caseStudy);

const profiles = [
  { label: "LinkedIn", href: social.linkedin, icon: LinkedInIcon },
  { label: "GitHub", href: social.github, icon: GitHubIcon },
];
---

<section id="hero" class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1 class="hero-name reveal">{hero.name}</h1>
      <p class="hero-role reveal">{hero.role}</p>
      <p class="hero-support reveal">{hero.supportingText}</p>

      <div class="hero-actions reveal">
        <a href={hero.cta.href} class="button-primary">
          {hero.cta.label}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            aria-hidden="true"
          >
            <path d="M12 5v14M6 13l6 6 6-6"></path>
          </svg>
        </a>
        {
          profiles.map((profile) => (
            <a
              href={profile.href}
              target="_blank"
              rel="noopener noreferrer"
              class="button-secondary hero-profile"
            >
              <span
                class="hero-profile__icon"
                aria-hidden="true"
                set:html={profile.icon}
              />
              {profile.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero-visual reveal">
      <DeployPipeline lang={lang} />
    </div>

    <dl class="hero-facts reveal">
      <div class="hero-fact">
        <dt>{ui.hero.location}</dt>
        <dd>{about.location}</dd>
      </div>
      <div class="hero-fact" data-clock hidden>
        <dt>{ui.hero.localTime}</dt>
        <dd>
          <span class="hero-clock" data-clock-time></span>
          <span class="hero-clock__zone" data-clock-zone></span>
        </dd>
      </div>
      {
        caseProject?.caseStudy && (
          <div class="hero-fact hero-fact--wide">
            <dt>{ui.hero.caseStudy}</dt>
            <dd>
              <a
                href={localePath(lang, caseProject.caseStudy)}
                class="hero-case"
              >
                <span class="hero-case__title">{caseProject.title}</span>
                <span class="hero-case__label">{caseProject.shortLabel}</span>
                <svg
                  class="hero-case__arrow"
                  aria-hidden="true"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="square"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </dd>
          </div>
        )
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero-inner {
    position: relative;
    isolation: isolate;
    width: min(100% - var(--page-gutter) * 2, var(--content-width));
    margin-inline: auto;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .hero-name {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .hero-role {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .hero-support {
    max-width: 58ch;
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  @media (max-width: 479px) {
    .hero-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-actions .button-primary {
      grid-column: 1 / -1;
    }
  }

  .hero-profile__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    transition: transform var(--transition-base);
  }

  .hero-profile__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .hero-profile:hover .hero-profile__icon {
    transform: translateY(-1px);
  }

  /* Franja de datos al pie del hero */
  .hero-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: clamp(0.5rem, 3vw, 2rem) 0 0;
    border-top: 1px solid var(--color-line-strong);
    border-bottom: 1px solid var(--color-line);
  }

  .hero-fact {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    padding: 0.9rem 1rem 1rem 0;
  }

  .hero-fact[hidden] {
    display: none;
  }

  .hero-fact dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  .hero-fact dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .hero-fact--wide {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-line);
  }

  .hero-clock {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .hero-clock :global(.hero-clock__colon) {
    animation: clock-blink 2s steps(1) infinite;
  }

  .hero-clock__zone {
    margin-left: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-soft);
  }

  @keyframes clock-blink {
    50% {
      opacity: 0.25;
    }
  }

  .hero-case {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .hero-case__title {
    font-weight: 600;
    transition: color var(--transition-base);
  }

  .hero-case__label {
    color: var(--color-text-muted);
  }

  .hero-case__arrow {
    align-self: center;
    transition: transform var(--transition-base);
  }

  .hero-case:hover .hero-case__title,
  .hero-case:focus-visible .hero-case__title {
    color: var(--color-accent);
  }

  .hero-case:hover .hero-case__arrow,
  .hero-case:focus-visible .hero-case__arrow {
    transform: translateX(3px);
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
      row-gap: clamp(3.5rem, 6vw, 5rem);
    }

    .hero-copy {
      grid-column: 1 / span 6;
    }

    .hero-visual {
      grid-column: 7 / span 6;
    }

    .hero-facts {
      grid-column: 1 / -1;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
      margin-top: 0;
    }

    .hero-fact:nth-child(1) {
      grid-column: 1 / span 3;
    }

    .hero-fact:nth-child(2) {
      grid-column: 4 / span 3;
    }

    .hero-fact:nth-child(2),
    .hero-fact--wide {
      margin-left: calc(var(--page-gutter) * -0.5);
      padding-left: calc(var(--page-gutter) * 0.5);
      border-left: 1px solid var(--color-line);
    }

    .hero-fact--wide {
      grid-column: 7 / span 6;
      border-top: 0;
    }

    /* Líneas de construcción sobre la grilla real: los bordes y el eje
       entre el texto y el pipeline, sin cruzar el texto */
    .hero-inner::before {
      content: "";
      position: absolute;
      z-index: -1;
      top: calc(clamp(3.5rem, 8vw, 6.5rem) * -1);
      bottom: 0;
      left: calc(var(--page-gutter) * -0.5);
      right: calc(var(--page-gutter) * -0.5);
      background-image: linear-gradient(
        to right,
        var(--hero-grid) 0 1px,
        transparent 1px
      );
      background-size: 50% 100%;
      border-right: 1px solid var(--hero-grid);
      mask-image: linear-gradient(
        to bottom,
        transparent,
        #000 18%,
        #000 78%,
        transparent
      );
      pointer-events: none;
    }
  }

  .hero-inner {
    --hero-grid: color-mix(in oklab, var(--color-line) 70%, transparent);
  }
</style>

<script>
  // Hora local de Puerto Montt; se actualiza al cambiar el minuto.
  const clock = document.querySelector<HTMLElement>("[data-clock]");
  const time = clock?.querySelector<HTMLElement>("[data-clock-time]");
  const zone = clock?.querySelector<HTMLElement>("[data-clock-zone]");

  if (clock && time && zone) {
    const timeZone = "America/Santiago";
    const locale = document.documentElement.lang === "en" ? "en-US" : "es-CL";
    const timeFormat = new Intl.DateTimeFormat(locale, {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZone,
    });
    const zoneFormat = new Intl.DateTimeFormat("en-US", {
      timeZone,
      timeZoneName: "shortOffset",
    });

    const part = (parts: Intl.DateTimeFormatPart[], type: string) =>
      parts.find((item) => item.type === type)?.value ?? "";

    function render() {
      const now = new Date();
      const parts = timeFormat.formatToParts(now);
      const colon = document.createElement("span");
      colon.className = "hero-clock__colon";
      colon.textContent = ":";
      time!.replaceChildren(part(parts, "hour"), colon, part(parts, "minute"));
      zone!.textContent = part(
        zoneFormat.formatToParts(now),
        "timeZoneName",
      ).replace("-", "−");
      clock!.hidden = false;

      const untilNextMinute =
        60_000 - (now.getSeconds() * 1000 + now.getMilliseconds());
      window.setTimeout(render, untilNextMinute + 50);
    }

    render();
  }
</script>

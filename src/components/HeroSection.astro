---
import { Image } from "astro:assets";
import { HERO_DATA, PROJECTS } from "../utils/data";

const favoriteProjects = PROJECTS.filter((project) => project.favorite);
const profileImage =
  "https://media.licdn.com/dms/image/v2/D4E03AQGQw7z9wYWpeg/profile-displayphoto-crop_800_800/B4EZozJMsOGcAM-/0/1761794643954?e=1778716800&v=beta&t=JXEKBejWLxTMoAm8Rx7hWB8pNkxda-C-nv3yqXjVl2w";
---

<section id="hero" class="hero">
  <!-- Dramatic animated background orbs -->
  <div class="hero-orb hero-orb--1" aria-hidden="true"></div>
  <div class="hero-orb hero-orb--2" aria-hidden="true"></div>
  <div class="hero-orb hero-orb--3" aria-hidden="true"></div>

  <!-- Grid pattern overlay -->
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Floating decorative elements -->
  <div class="hero-float hero-float--1" aria-hidden="true"></div>
  <div class="hero-float hero-float--2" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <div class="hero-brand-wrap">
        <div class="hero-brand-lockup reveal">
          <img
            src={profileImage}
            alt="Foto de perfil de Patricio Gómez"
            class="hero-avatar"
            loading="eager"
            decoding="async"
          />
          <div class="hero-identity">
            <p class="hero-name">{HERO_DATA.name}</p>
            <p class="hero-role">{HERO_DATA.role}</p>
          </div>
        </div>
        <span class="hero-brand-line reveal" aria-hidden="true"></span>
      </div>

      <p class="hero-support reveal" data-delay="2">
        {HERO_DATA.supportingText}
      </p>

      <div class="button-row reveal" data-delay="3">
        <a
          href={HERO_DATA.primaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="button-primary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          {HERO_DATA.primaryCta.label}
        </a>
        <a href={HERO_DATA.secondaryCta.href} class="button-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 16 12 12 8 16"/>
            <line x1="12" y1="12" x2="12" y2="21"/>
            <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
          </svg>
          {HERO_DATA.secondaryCta.label}
        </a>
      </div>
    </div>

    <div
      class="hero-stage reveal"
      data-delay="2"
      data-carousel
      aria-label="Carrusel de sistemas destacados"
    >
      <div class="hero-carousel">
        {
          favoriteProjects.map((project, index) => (
            <article
              class:list={["hero-slide", index === 0 && "is-active"]}
              data-slide
              data-project-key={project.key}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <div class="hero-slide__glow" aria-hidden="true" />

              <a
                href={project.link ?? "#contacto"}
                target={project.link ? "_blank" : undefined}
                rel={project.link ? "noopener noreferrer" : undefined}
                class="hero-slide__frame browser-frame"
                aria-label={`Abrir ${project.title}`}
              >
                <Image
                  src={project.image}
                  alt={`Captura del proyecto ${project.title}`}
                  class="hero-slide__image"
                  widths={[900, 1280, 1600]}
                  sizes="(max-width: 960px) 100vw, 52vw"
                  loading={index === 0 ? "eager" : "lazy"}
                  format="webp"
                />

                <div class="hero-slide__overlay">
                  <span class="hero-slide__cta">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15 3 21 3 21 9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </span>
                </div>
              </a>

              <div class="hero-slide__meta">
                <div class="hero-slide__meta-main">
                  <span class="hero-slide__label">Últimas aplicaciones</span>
                  <strong>{project.title}</strong>
                  <p class="hero-slide__summary">{project.shortLabel}</p>
                </div>

                <ul class="stack-list">
                  {project.tags.slice(0, 4).map((tag) => (
                    <li class="stack-chip">
                      <span class="stack-chip__icon" set:html={tag.icon} />
                      <span class="stack-chip__label">{tag.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <div
        class="hero-carousel__controls"
        aria-label="Seleccionar últimas aplicaciones"
      >
        {
          favoriteProjects.map((project, index) => (
            <button
              type="button"
              class:list={["hero-carousel__dot", index === 0 && "is-active"]}
              data-carousel-dot
              data-index={index}
              aria-label={`Mostrar ${project.title}`}
              aria-pressed={index === 0 ? "true" : "false"}
            />
          ))
        }
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll" aria-hidden="true">
    <div class="hero-scroll__line"></div>
    <span>Scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: clamp(7rem, 10vw, 9rem) var(--page-gutter) 3rem;
    overflow: hidden;
    contain: paint;
  }

  /* Animated gradient orbs */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    animation: float 20s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-orb--1 {
    width: 40vw;
    height: 40vw;
    max-width: 600px;
    max-height: 600px;
    top: -15%;
    left: -6%;
    background: radial-gradient(circle, rgba(212, 168, 83, 0.3) 0%, transparent 70%);
    animation-delay: 0s;
  }

  .hero-orb--2 {
    width: 30vw;
    height: 30vw;
    max-width: 500px;
    max-height: 500px;
    top: 20%;
    right: -2%;
    background: radial-gradient(circle, rgba(212, 168, 83, 0.2) 0%, transparent 70%);
    animation-delay: -7s;
    animation-duration: 25s;
  }

  .hero-orb--3 {
    width: 25vw;
    height: 25vw;
    max-width: 400px;
    max-height: 400px;
    bottom: 10%;
    left: 30%;
    background: radial-gradient(circle, rgba(236, 200, 122, 0.15) 0%, transparent 70%);
    animation-delay: -14s;
    animation-duration: 30s;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(3%, 5%) scale(1.05);
    }
    50% {
      transform: translate(-2%, 3%) scale(0.95);
    }
    75% {
      transform: translate(4%, -2%) scale(1.02);
    }
  }

  /* Grid pattern */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 0%, transparent 70%);
    pointer-events: none;
  }

  /* Floating decorative elements */
  .hero-float {
    position: absolute;
    border: 1px solid rgba(212, 168, 83, 0.15);
    border-radius: 50%;
    pointer-events: none;
    animation: drift 15s ease-in-out infinite;
  }

  .hero-float--1 {
    width: 120px;
    height: 120px;
    top: 25%;
    right: 15%;
    animation-delay: -5s;
  }

  .hero-float--2 {
    width: 60px;
    height: 60px;
    bottom: 30%;
    left: 8%;
    animation-delay: -10s;
    animation-duration: 20s;
  }

  @keyframes drift {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0.4;
    }
    50% {
      transform: translate(20px, -30px) rotate(180deg);
      opacity: 0.7;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: min(100%, var(--content-width));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(27rem, 0.96fr);
    gap: clamp(3rem, 4.6vw, 4.5rem);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    transform: translateY(clamp(-1.35rem, -2vw, -0.65rem));
  }

  .hero-copy > * {
    max-width: 100%;
  }

  .hero-brand-wrap {
    position: relative;
    display: grid;
    gap: clamp(1.15rem, 1.9vw, 1.55rem);
    margin-bottom: clamp(1.6rem, 2.5vw, 2.1rem);
    min-width: 0;
    max-width: 40.5rem;
  }

  .hero-brand-line {
    display: block;
    width: 100%;
    max-width: 35.5rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(212, 168, 83, 0.62) 12%,
      rgba(212, 168, 83, 0.2) 100%
    );
    animation: lineGrow 1s ease-out forwards;
  }

  @keyframes lineGrow {
    from {
      transform: scaleX(0);
      opacity: 0;
      transform-origin: left;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
      transform-origin: left;
    }
  }

  .hero-brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.15rem, 2.1vw, 1.75rem);
    min-width: 0;
  }

  .hero-avatar {
    width: clamp(5.65rem, 8.25vw, 7.75rem);
    height: clamp(5.65rem, 8.25vw, 7.75rem);
    border-radius: 50%;
    border: 1px solid rgba(212, 168, 83, 0.46);
    object-fit: cover;
    box-shadow:
      0 0 0 3px rgba(8, 10, 13, 0.78),
      0 18px 48px rgba(0, 0, 0, 0.34),
      0 0 34px rgba(212, 168, 83, 0.14);
    flex: 0 0 auto;
  }

  .hero-identity {
    display: grid;
    gap: 0.48rem;
    min-width: 0;
  }

  .hero-name {
    margin: 0;
    display: block;
    font-family: var(--font-display);
    max-width: 100%;
    font-size: clamp(2.8rem, 5.45vw, 4.7rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    white-space: nowrap;
    background: linear-gradient(
      135deg,
      var(--color-text) 0%,
      var(--color-accent-strong) 50%,
      var(--color-text) 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShift 8s ease-in-out infinite;
  }

  .hero-role {
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(0.8rem, 1.08vw, 0.98rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-support {
    margin: 0 0 clamp(2.15rem, 3vw, 2.65rem);
    max-width: 40rem;
    color: var(--color-text-muted);
    font-size: clamp(1.12rem, 1.5vw, 1.26rem);
    line-height: 1.78;
  }

  .hero :global(.button-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero :global(.button-primary),
  .hero :global(.button-secondary) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Stage / Carousel */
  .hero-stage {
    display: grid;
    gap: 1.2rem;
    justify-items: center;
    min-width: 0;
  }

  .hero-carousel {
    position: relative;
    width: 100%;
    max-width: 42rem;
    min-height: clamp(32rem, 43vw, 39rem);
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: grid;
    gap: 1.2rem;
    align-content: start;
    opacity: 0;
    pointer-events: none;
    transform: translateY(24px);
    transition:
      opacity 450ms ease,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .hero-slide__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, rgba(212, 168, 83, 0.15) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .hero-slide.is-active .hero-slide__glow {
    opacity: 1;
  }

  .hero-slide__frame {
    display: block;
    width: 100%;
    transform: perspective(1400px) rotateY(-8deg) rotateX(2deg);
    transform-origin: center;
    transition:
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 600ms ease;
    cursor: pointer;
  }

  .hero-slide__frame:hover,
  .hero-slide__frame:focus-visible {
    transform: perspective(1400px) rotateY(-4deg) rotateX(1deg) translateY(-8px);
    box-shadow:
      var(--shadow-soft),
      0 0 60px rgba(212, 168, 83, 0.15);
  }

  .hero-slide__image {
    aspect-ratio: 1.4 / 1;
    transition: transform 700ms ease;
  }

  .hero-slide__frame:hover .hero-slide__image {
    transform: scale(1.02);
  }

  .hero-slide__overlay {
    position: absolute;
    inset: 2.6rem 0 0 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 1rem;
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .hero-slide__frame:hover .hero-slide__overlay {
    opacity: 1;
  }

  .hero-slide__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(212, 168, 83, 0.9);
    color: var(--color-bg);
    backdrop-filter: blur(8px);
  }

  .hero-slide__meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    align-items: start;
    width: 100%;
  }

  .hero-slide__meta-main {
    display: grid;
    gap: 0.4rem;
    width: 100%;
  }

  .hero-slide__meta :global(.stack-list) {
    width: 100%;
    justify-content: flex-start;
    align-self: start;
  }

  .hero-slide__label {
    display: inline-block;
    color: var(--color-accent);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero-slide__meta strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.16rem;
    letter-spacing: -0.02em;
  }

  .hero-slide__summary {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0.25rem 0 0;
  }

  /* Carousel controls */
  .hero-carousel__controls {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .hero-carousel__dot {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(240, 235, 226, 0.2);
    cursor: pointer;
    transition:
      transform var(--transition-bounce),
      background-color var(--transition-base),
      width var(--transition-base);
  }

  .hero-carousel__dot.is-active {
    width: 2rem;
    background: var(--color-accent);
    transform: scale(1);
  }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-soft);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: scrollBounce 2s ease-in-out infinite;
  }

  .hero-scroll__line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(180deg, var(--color-accent), transparent);
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.6; }
    50% { transform: translateX(-50%) translateY(8px); opacity: 1; }
  }

  /* Responsive */
  @media (max-width: 1180px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-copy {
      transform: none;
    }

    .hero-stage {
      width: 100%;
      max-width: 44rem;
      justify-self: center;
    }
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
      padding-top: 6rem;
      padding-bottom: 2rem;
    }

    .hero-name {
      font-size: clamp(2rem, 9.5vw, 2.85rem);
    }

    .hero-avatar {
      width: clamp(3.75rem, 16vw, 4.55rem);
      height: clamp(3.75rem, 16vw, 4.55rem);
    }

    .hero-role {
      font-size: 0.66rem;
      letter-spacing: 0.06em;
    }

    .hero-support {
      font-size: 0.95rem;
    }

    .hero-stage {
      gap: 1rem;
    }

    .hero-carousel {
      min-height: 28rem;
    }

    .hero-slide__frame {
      transform: none;
    }

    .hero-slide__image {
      aspect-ratio: 1.6 / 1;
    }

    .hero-slide__meta {
      grid-template-columns: 1fr;
    }

    .hero-scroll {
      display: none;
    }

    .hero-float {
      display: none;
    }
  }
</style>

<script>
  const heroSection = document.getElementById("hero");
  const heroBackdrop = heroSection?.querySelector(".hero-backdrop");
  const heroItems = heroSection?.querySelectorAll(".reveal");
  const heroCarousel = heroSection?.querySelector("[data-carousel]");
  const heroSlides = heroCarousel?.querySelectorAll("[data-slide]") ?? [];
  const heroDots = heroCarousel?.querySelectorAll("[data-carousel-dot]") ?? [];
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  let activeIndex = 0;
  let autoplayId;

  function revealHeroItems() {
    heroItems?.forEach((item) => item.classList.add("is-visible"));
  }

  function setActiveSlide(nextIndex) {
    if (!heroSlides.length) return;
    activeIndex = nextIndex;

    heroSlides.forEach((slide, index) => {
      const isActive = index === activeIndex;
      slide.classList.toggle("is-active", isActive);
      slide.setAttribute("aria-hidden", String(!isActive));
    });

    heroDots.forEach((dot, index) => {
      const isActive = index === activeIndex;
      dot.classList.toggle("is-active", isActive);
      dot.setAttribute("aria-pressed", String(isActive));
    });
  }

  function startAutoplay() {
    if (prefersReducedMotion || heroSlides.length < 2) return;
    stopAutoplay();
    autoplayId = window.setInterval(() => {
      setActiveSlide((activeIndex + 1) % heroSlides.length);
    }, 2500);
  }

  function stopAutoplay() {
    if (!autoplayId) return;
    window.clearInterval(autoplayId);
    autoplayId = undefined;
  }

  function updateHeroDepth() {
    if (!heroSection || prefersReducedMotion) return;
    const rect = heroSection.getBoundingClientRect();
    const progress = Math.max(0, Math.min(1, -rect.top / window.innerHeight));

    heroSlides.forEach((slide) => {
      const frame = slide.querySelector(".hero-slide__frame");
      if (frame instanceof HTMLElement && window.innerWidth > 960) {
        frame.style.transform = `perspective(1400px) rotateY(${-8 + progress * 3}deg) rotateX(${2 - progress}deg) translateY(${progress * 12}px)`;
      }
    });

    const orbs = heroSection.querySelectorAll(".hero-orb");
    orbs.forEach((orb, i) => {
      const speed = (i + 1) * 0.3;
      orb.setAttribute(
        "style",
        `transform: translateY(${progress * -30 * speed}px)`,
      );
    });
  }

  heroDots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      setActiveSlide(index);
      startAutoplay();
    });
  });

  heroCarousel?.addEventListener("mouseenter", stopAutoplay);
  heroCarousel?.addEventListener("mouseleave", startAutoplay);

  requestAnimationFrame(revealHeroItems);
  setActiveSlide(0);
  startAutoplay();
  window.addEventListener("scroll", updateHeroDepth, { passive: true });
  updateHeroDepth();

  document.addEventListener("astro:before-swap", () => {
    stopAutoplay();
    window.removeEventListener("scroll", updateHeroDepth);
  });
</script>

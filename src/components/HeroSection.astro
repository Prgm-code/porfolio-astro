---
import GitHubIcon from "../icons/GitHub.svg?raw";
import LinkedInIcon from "../icons/LinkedIn.svg?raw";
import MailIcon from "../icons/Mail.svg?raw";
import WhatsAppIcon from "../icons/WhatsApp.svg?raw";
import { HERO_DATA } from "../utils/data";
---

<section id="hero" class="relative min-h-screen flex items-center px-4 sm:px-6 lg:px-8 py-24 lg:py-0 overflow-hidden">
  <!-- Simple CSS Particles Background (Performance optimized) -->
  <div class="particles-container absolute inset-0 z-0">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(0,60,80,0.25),rgba(0,0,0,0))] z-0"></div>

  <div class="max-w-6xl mx-auto w-full relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text Column -->
      <div class="order-2 lg:order-1 text-center lg:text-left">
        <!-- Greeting -->
        <p class="animate text-[var(--color-text-secondary)] text-sm md:text-base mb-3 uppercase tracking-widest">
          {HERO_DATA.greeting}
        </p>

        <!-- Name -->
        <h1 class="animate animate-delay-100 text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
          {HERO_DATA.name}
        </h1>

        <!-- Title with gradient -->
        <h2 class="animate animate-delay-200 text-xl md:text-2xl lg:text-3xl font-semibold mb-6">
          <span class="text-white">Y soy </span>
          <span class="bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">
            {HERO_DATA.title}
          </span>
        </h2>

        <!-- Description -->
        <p class="animate animate-delay-300 text-[var(--color-text-secondary)] text-base md:text-lg max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed">
          {HERO_DATA.description}
        </p>

        <!-- Social Icons -->
        <div class="animate animate-delay-400 flex justify-center lg:justify-start gap-3 mb-8">
          {HERO_DATA.social.github && (
            <a
              href={HERO_DATA.social.github}
              target="_blank" 
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-card-border)] bg-[var(--color-card)] hover:border-[var(--color-primary)] hover:bg-[var(--color-card-hover)] transition-all duration-300 hover:scale-110"
              aria-label="GitHub"
            >
              <span class="w-5 h-5 text-white flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={GitHubIcon} />
            </a>
          )}
          {HERO_DATA.social.linkedin && (
            <a
              href={HERO_DATA.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-card-border)] bg-[var(--color-card)] hover:border-[var(--color-primary)] hover:bg-[var(--color-card-hover)] transition-all duration-300 hover:scale-110"
              aria-label="LinkedIn"
            >
              <span class="w-5 h-5 text-white flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={LinkedInIcon} />
            </a>
          )}
          {HERO_DATA.social.email && (
            <a
              href={`mailto:${HERO_DATA.social.email}`}
              class="w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-card-border)] bg-[var(--color-card)] hover:border-[var(--color-primary)] hover:bg-[var(--color-card-hover)] transition-all duration-300 hover:scale-110"
              aria-label="Email"
            >
              <span class="w-5 h-5 text-white flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={MailIcon} />
            </a>
          )}
          {HERO_DATA.social.whatsapp && (
            <a
              href={HERO_DATA.social.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full border border-[var(--color-card-border)] bg-[var(--color-card)] hover:border-[var(--color-primary)] hover:bg-[var(--color-card-hover)] transition-all duration-300 hover:scale-110"
              aria-label="WhatsApp"
            >
              <span class="w-5 h-5 text-white flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={WhatsAppIcon} />
            </a>
          )}
        </div>

        <!-- CTA Button -->
        <div class="animate animate-delay-500">
          <a
            href="#about"
            class="btn-primary inline-flex items-center text-sm md:text-base"
          >
            Leer Más
          </a>
        </div>
      </div>

      <!-- Image Column -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end animate-scale">
        <div class="relative">
          <!-- Glow effect behind image -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-cyan-500/30 to-blue-600/20 blur-2xl scale-110"></div>
          
          <!-- Main image -->
          <div class="relative">
            <img
              src={HERO_DATA.image}
              alt={`Foto de ${HERO_DATA.name}`}
              class="w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 rounded-full object-cover border-4 border-[var(--color-primary)]/50 shadow-2xl glow-pulse"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Simple CSS-based particles - no JS, very lightweight */
  .particles-container {
    pointer-events: none;
  }
  
  .particle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: rgba(0, 212, 255, 0.6);
    border-radius: 50%;
    animation: float 20s infinite;
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.5), 0 0 20px rgba(0, 212, 255, 0.3);
  }
  
  .particle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; animation-duration: 25s; width: 4px; height: 4px; }
  .particle:nth-child(2) { left: 20%; top: 60%; animation-delay: -3s; animation-duration: 22s; width: 8px; height: 8px; }
  .particle:nth-child(3) { left: 35%; top: 30%; animation-delay: -5s; animation-duration: 28s; width: 5px; height: 5px; }
  .particle:nth-child(4) { left: 50%; top: 70%; animation-delay: -2s; animation-duration: 24s; width: 7px; height: 7px; }
  .particle:nth-child(5) { left: 65%; top: 25%; animation-delay: -7s; animation-duration: 26s; width: 4px; height: 4px; }
  .particle:nth-child(6) { left: 75%; top: 55%; animation-delay: -4s; animation-duration: 23s; width: 6px; height: 6px; }
  .particle:nth-child(7) { left: 85%; top: 40%; animation-delay: -1s; animation-duration: 27s; width: 5px; height: 5px; }
  .particle:nth-child(8) { left: 90%; top: 80%; animation-delay: -6s; animation-duration: 21s; width: 8px; height: 8px; }
  
  @keyframes float {
    0%, 100% {
      transform: translateY(0) translateX(0);
      opacity: 0.6;
    }
    25% {
      transform: translateY(-50px) translateX(20px);
      opacity: 0.9;
    }
    50% {
      transform: translateY(-25px) translateX(-25px);
      opacity: 0.5;
    }
    75% {
      transform: translateY(-60px) translateX(15px);
      opacity: 0.8;
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .particle {
      animation: none;
    }
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  }, observerOptions);

  document.querySelectorAll('#hero .animate, #hero .animate-scale').forEach(el => {
    observer.observe(el);
  });
</script>

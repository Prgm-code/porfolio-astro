---
import { SOCIAL_BASE } from "../i18n/data.shared";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>© {currentYear} Patricio Gómez</p>
    <ul>
      <li>
        <a href={SOCIAL_BASE.github} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
      </li>
      <li>
        <a href={SOCIAL_BASE.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
      </li>
      <li><a href={SOCIAL_BASE.email}>contacto@prgm.cl</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    --color-inverse-text: var(--color-text);
    --color-inverse-line: var(--color-line);
    --color-inverse-accent: var(--color-accent);
    color: var(--color-text-soft);
    font-size: 0.875rem;
  }

  .site-footer__inner {
    width: min(100% - var(--page-gutter) * 2, var(--content-width));
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-inverse-line);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    transition: color var(--transition-base);
  }

  a:hover,
  a:focus-visible {
    color: var(--color-inverse-text);
  }

  .site-footer :focus-visible {
    outline-color: var(--color-inverse-accent);
  }
</style>

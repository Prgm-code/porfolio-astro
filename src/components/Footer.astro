---
import GithubIcon from "../icons/GitHub.svg?raw";
import AstroIcon from "../icons/AstroIcon.svg?raw";
---

<footer
  class="py-8 px-4 sm:px-6 lg:px-8 border-t border-[var(--color-card-border)]"
>
  <div
    class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4"
  >
    <!-- Copyright -->
    <p
      class="text-sm text-[var(--color-text-secondary)] text-center md:text-left"
    >
      © {new Date().getFullYear()} <span class="text-[var(--color-primary)]">Patricio Gómez</span>.
      Todos los derechos reservados.
    </p>

    <!-- Made with love -->
    <p class="text-sm text-[var(--color-text-muted)] flex items-center gap-1">
      Made with
      <span class="text-red-500 animate-pulse">❤</span>
      for amazing clients
    </p>

    <!-- Links -->
    <div class="flex items-center gap-4">
      <a
        href="https://astro.build/"
        target="_blank"
        class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors"
      >
        <span class="flex items-center gap-1">
          Built with
          <span class="w-4 h-4 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={AstroIcon} />
          Astro
        </span>
      </a>
      <a
        href="https://github.com/Prgm-code/porfolio-astro"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors"
      >
        <span class="w-4 h-4 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={GithubIcon} />
        View Code
      </a>
    </div>
  </div>
</footer>

---
import AstroIcon from "../icons/AstroIcon.svg?raw";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__logo">prgm.cl</span>
      <p>Patricio Gómez · Full Stack TypeScript Developer</p>
    </div>

    <div class="site-footer__links">
      <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
        <span class="site-footer__icon" set:html={AstroIcon} />
        Astro
      </a>
    </div>

    <div class="site-footer__copy">
      <p>© {currentYear} Patricio Gómez</p>
      <span class="site-footer__divider">·</span>
      <p>Diseñado y desarrollado con dedicación</p>
    </div>
  </div>

  <!-- Decorative gradient line -->
  <div class="site-footer__gradient" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 0 0 calc(var(--page-gutter) + 1rem);
  }

  .site-footer__inner {
    width: min(100% - (var(--page-gutter) * 2), var(--content-width));
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .site-footer__brand {
    display: grid;
    gap: 0.3rem;
  }

  .site-footer__logo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent-strong) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .site-footer__brand p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .site-footer__links {
    display: flex;
    gap: 1.5rem;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-soft);
    font-size: 0.82rem;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    color: var(--color-accent-strong);
  }

  .site-footer__icon {
    display: inline-flex;
    width: 0.9rem;
    height: 0.9rem;
  }

  .site-footer__icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .site-footer__copy {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .site-footer__copy p {
    margin: 0;
  }

  .site-footer__divider {
    color: var(--color-accent);
    opacity: 0.4;
  }

  .site-footer__gradient {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(212, 168, 83, 0.4),
      transparent
    );
  }

  @media (max-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.5rem;
    }

    .site-footer__brand {
      justify-items: center;
    }

    .site-footer__links {
      justify-content: center;
    }

    .site-footer__copy {
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 480px) {
    .site-footer__links {
      flex-direction: column;
      gap: 0.8rem;
    }
  }
</style>

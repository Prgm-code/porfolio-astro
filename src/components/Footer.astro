---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__logo">prgm.cl</span>
      <p>Patricio Gómez · Full Stack TypeScript Developer</p>
    </div>

    <div class="site-footer__links">
      <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        Astro
      </a>
      <a
        href="https://github.com/Prgm-code/porfolio-astro"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Código fuente
      </a>
    </div>

    <div class="site-footer__copy">
      <p>© {currentYear} Patricio Gómez</p>
      <span class="site-footer__divider">·</span>
      <p>Diseñado y desarrollado con dedicación</p>
    </div>
  </div>

  <!-- Decorative gradient line -->
  <div class="site-footer__gradient" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 0 0 calc(var(--page-gutter) + 1rem);
  }

  .site-footer__inner {
    width: min(100% - (var(--page-gutter) * 2), var(--content-width));
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .site-footer__brand {
    display: grid;
    gap: 0.3rem;
  }

  .site-footer__logo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent-strong) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .site-footer__brand p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .site-footer__links {
    display: flex;
    gap: 1.5rem;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-soft);
    font-size: 0.82rem;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    color: var(--color-accent-strong);
  }

  .site-footer__copy {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .site-footer__copy p {
    margin: 0;
  }

  .site-footer__divider {
    color: var(--color-accent);
    opacity: 0.4;
  }

  .site-footer__gradient {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(212, 168, 83, 0.4),
      transparent
    );
  }

  @media (max-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.5rem;
    }

    .site-footer__brand {
      justify-items: center;
    }

    .site-footer__links {
      justify-content: center;
    }

    .site-footer__copy {
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 480px) {
    .site-footer__links {
      flex-direction: column;
      gap: 0.8rem;
    }
  }
</style>

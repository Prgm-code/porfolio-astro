---
import { getData, getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const data = getData(lang);
---

<section id="stack" class="page-section">
  <div class="section-inner">
    <header class="section-head reveal">
      <h2 class="section-title">{ui.services.title}</h2>
    </header>

    <div class="stack-grid">
      {
        data.stack.map((group) => (
          <div class="stack-group reveal">
            <h3 class="stack-group__title">{group.title}</h3>
            <ul class="stack-group__items">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 2.5rem var(--page-gutter);
  }

  @media (min-width: 960px) {
    .stack-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stack-group {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .stack-group__title {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .stack-group__items {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>

---
import { SKILLS } from "../utils/data";
---

<section id="skills" class="py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <h2 class="section-title animate">Habilidades</h2>
    
    <p class="animate animate-delay-100 text-center text-[var(--color-text-secondary)] text-lg mb-12 max-w-2xl mx-auto">
      Tecnologías y herramientas que utilizo para construir soluciones digitales de alto rendimiento.
    </p>

    <div class="space-y-12">
      {SKILLS.map((category, categoryIndex) => (
        <div class={`animate animate-delay-${(categoryIndex % 3 + 1) * 100}`}>
          <!-- Category Header -->
          <div class="flex items-center gap-3 mb-6">
            <span class="w-10 h-10 text-[var(--color-primary)] flex items-center justify-center [&>svg]:w-full [&>svg]:h-full" set:html={category.icon} />
            <h3 class="text-xl font-semibold text-white">
              {category.title}
            </h3>
          </div>

          <!-- Skills Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            {category.skills.map((skill, skillIndex) => (
              <div 
                class="glass-card p-4 flex flex-col items-center justify-center gap-3 group hover:border-[var(--color-primary)]/40 transition-all duration-300 hover:scale-105"
              >
                <span 
                  class="w-10 h-10 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full text-white group-hover:text-[var(--color-primary)] transition-colors" 
                  set:html={skill.icon} 
                />
                <span class="text-sm text-center text-[var(--color-text-secondary)] group-hover:text-white transition-colors font-medium">
                  {skill.name}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  }, observerOptions);

  document.querySelectorAll('#skills .animate').forEach(el => {
    observer.observe(el);
  });
</script>

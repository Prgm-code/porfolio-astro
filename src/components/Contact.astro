---
import { getData, getUi, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const { social } = getData(lang);
---

<section id="contacto" class="page-section contact">
  <div class="section-inner">
    <header class="section-head contact-head reveal">
      <h2 class="section-title">{ui.contact.title}</h2>
    </header>

    <div class="contact-grid">
      <div class="contact-copy reveal">
        <ul class="contact-links">
          <li>
            <a href={social.whatsapp} target="_blank" rel="noopener noreferrer"
              >{ui.contact.whatsappCta}</a
            >
          </li>
          <li><a href={social.email}>contacto@prgm.cl</a></li>
        </ul>
      </div>

      <div class="contact-form reveal">
        <form
          action="https://formspree.io/f/xbddooda"
          method="POST"
          aria-label={ui.contact.formTitle}
          data-sending={ui.contact.sending}
          data-success-title={ui.contact.successTitle}
          data-success-text={ui.contact.successText}
          data-error={ui.contact.errorText}
        >
          <div class="field-row">
            <div class="field-group">
              <label for="name">{ui.contact.labelName}</label>
              <input
                type="text"
                name="name"
                id="name"
                autocomplete="name"
                placeholder={ui.contact.placeholderName}
                required
              />
            </div>

            <div class="field-group">
              <label for="email">{ui.contact.labelEmail}</label>
              <input
                type="email"
                name="email"
                id="email"
                autocomplete="email"
                placeholder={ui.contact.placeholderEmail}
                required
              />
            </div>
          </div>

          <div class="field-group">
            <label for="message">{ui.contact.labelProject}</label>
            <textarea
              name="message"
              id="message"
              rows="5"
              placeholder={ui.contact.placeholderProject}
              required></textarea>
          </div>

          <button
            type="submit"
            class="contact-button contact-button--solid contact-submit"
          >
            <span class="contact-submit__spinner" aria-hidden="true"></span>
            <span data-submit-label>{ui.contact.submit}</span>
            <svg
              class="contact-submit__icon"
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </button>

          <div
            id="form-status"
            class="form-status"
            role="status"
            aria-live="polite"
            tabindex="-1"
            hidden
          >
            <strong data-status-title></strong>
            <span data-status-message></span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* Misma paleta que el resto de la página */
  .contact {
    --color-inverse-bg: var(--color-bg);
    --color-inverse-text: var(--color-text);
    --color-inverse-muted: var(--color-text-muted);
    --color-inverse-line: var(--color-line);
    --color-inverse-accent: var(--color-accent);
    color: var(--color-text);
  }

  .contact-links {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-links a {
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 0.3em;
    transition:
      color var(--transition-base),
      text-decoration-color var(--transition-base);
  }

  .contact-links a:hover,
  .contact-links a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .contact :focus-visible {
    outline-color: var(--color-inverse-accent);
  }

  .contact-head {
    border-top-color: var(--color-inverse-text);
  }

  .contact-grid {
    display: grid;
    gap: 3.5rem;
    margin-top: 0;
  }

  .contact-copy {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  /* Botones sobre fondo oscuro */
  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid var(--color-inverse-text);
    background: transparent;
    color: var(--color-inverse-text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--transition-base),
      color var(--transition-base),
      border-color var(--transition-base);
  }

  .contact-button:hover,
  .contact-button:focus-visible {
    background: var(--color-inverse-text);
    color: var(--color-inverse-bg);
  }

  .contact-button--solid {
    background: var(--color-inverse-text);
    color: var(--color-inverse-bg);
  }

  .contact-button--solid:hover,
  .contact-button--solid:focus-visible {
    background: var(--color-inverse-accent);
    border-color: var(--color-inverse-accent);
    color: var(--color-inverse-bg);
  }

  /* Canales */

  /* Formulario */
  .contact-form {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  form {
    display: grid;
    gap: 1.75rem;
  }

  .field-row {
    display: grid;
    gap: 1.75rem;
  }

  .field-group {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-size: 0.875rem;
    color: var(--color-inverse-muted);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.6rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
    color: var(--color-inverse-text);
    font: inherit;
    font-size: 1.05rem;
    transition: border-color var(--transition-base);
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-text-soft);
  }

  input:hover,
  textarea:hover {
    border-bottom-color: var(--color-inverse-muted);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--color-inverse-accent);
    box-shadow: 0 1px 0 0 var(--color-inverse-accent);
  }

  .contact-submit {
    justify-self: start;
    min-width: 12rem;
  }

  .contact-submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .contact-submit__spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .contact-submit.is-sending .contact-submit__spinner {
    display: inline-block;
  }

  .contact-submit.is-sending .contact-submit__icon {
    display: none;
  }

  @media (min-width: 720px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
    }

    .contact-copy {
      grid-column: 1 / span 5;
    }

    .contact-form {
      grid-column: 7 / span 6;
    }
  }
</style>

<script>
  // Form submit with fetch (no page redirect)
  const contactForm = document.querySelector<HTMLFormElement>("#contacto form");
  const btn = contactForm?.querySelector(".contact-submit");
  const submitLabel = btn?.querySelector("[data-submit-label]");
  const status = contactForm?.querySelector("#form-status");
  const statusTitle = status?.querySelector("[data-status-title]");
  const statusMessage = status?.querySelector("[data-status-message]");

  if (
    contactForm &&
    btn instanceof HTMLButtonElement &&
    submitLabel instanceof HTMLElement &&
    status instanceof HTMLElement &&
    statusTitle instanceof HTMLElement &&
    statusMessage instanceof HTMLElement
  ) {
    const formStatus = status;
    const formStatusTitle = statusTitle;
    const formStatusMessage = statusMessage;
    const originalLabel = submitLabel.textContent || "";
    const {
      sending = "Enviando...",
      successTitle = "Mensaje enviado",
      successText = "",
      error = "No se pudo enviar.",
    } = contactForm.dataset;

    function showStatus(
      kind: "success" | "error",
      title: string,
      message: string,
    ) {
      formStatus.hidden = false;
      formStatus.className =
        kind === "error" ? "form-status form-status--error" : "form-status";
      formStatus.setAttribute("role", kind === "error" ? "alert" : "status");
      formStatus.setAttribute(
        "aria-live",
        kind === "error" ? "assertive" : "polite",
      );
      formStatusTitle.textContent = title;
      formStatusMessage.textContent = message;
      formStatus.focus();
    }

    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      formStatus.hidden = true;
      formStatusTitle.textContent = "";
      formStatusMessage.textContent = "";
      contactForm.setAttribute("aria-busy", "true");
      btn.disabled = true;
      btn.classList.add("is-sending");
      submitLabel.textContent = sending;

      const formData = new FormData(contactForm);
      try {
        const response = await fetch(contactForm.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (!response.ok) throw new Error("Server error");
        contactForm.reset();
        showStatus("success", successTitle, successText);
      } catch {
        showStatus("error", error, "");
      } finally {
        contactForm.setAttribute("aria-busy", "false");
        btn.disabled = false;
        btn.classList.remove("is-sending");
        submitLabel.textContent = originalLabel;
      }
    });
  }
</script>

<style is:global>
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

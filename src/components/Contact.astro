---
import { SOCIAL_LINKS } from "../utils/data";
---

<section id="contacto" class="page-section">
  <div class="section-inner contact-layout">
    <div class="contact-copy reveal">
      <div class="section-header">
        <span class="section-kicker">Contacto</span>
        <h2 class="section-title">
          Si el proyecto necesita avanzar, conversemos directo.
        </h2>
        <p class="section-copy">
          Estoy disponible para construir producto, ordenar una operación con
          software o sacar una idea del bloqueo técnico.
        </p>
      </div>

      <div class="button-row">
        <a
          href={SOCIAL_LINKS.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="button-primary"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escribir por WhatsApp
        </a>
        <a href={SOCIAL_LINKS.email} class="button-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          Enviar email
        </a>
      </div>

      <ul class="contact-links">
        <li class="contact-link-item">
          <span class="contact-link-item__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </span>
          <div class="contact-link-item__content">
            <span>LinkedIn</span>
            <a
              href={SOCIAL_LINKS.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              /in/prgm
            </a>
          </div>
          <svg class="contact-link-item__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"/>
            <polyline points="7 7 17 7 17 17"/>
          </svg>
        </li>
        <li class="contact-link-item">
          <span class="contact-link-item__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </span>
          <div class="contact-link-item__content">
            <span>GitHub</span>
            <a
              href={SOCIAL_LINKS.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              github.com/Prgm-code
            </a>
          </div>
          <svg class="contact-link-item__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"/>
            <polyline points="7 7 17 7 17 17"/>
          </svg>
        </li>
        <li class="contact-link-item">
          <span class="contact-link-item__icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </span>
          <div class="contact-link-item__content">
            <span>Email</span>
            <a href={SOCIAL_LINKS.email}>contacto@prgm.cl</a>
          </div>
          <svg class="contact-link-item__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"/>
            <polyline points="7 7 17 7 17 17"/>
          </svg>
        </li>
      </ul>
    </div>

    <div class="contact-form-wrap reveal-form" data-delay="1">
      <div class="contact-form-glow" aria-hidden="true"></div>
      <div class="contact-form surface-panel">
        <div class="contact-form__header">
          <h3>Envíame un mensaje</h3>
          <p>Respuesta en menos de 24 horas.</p>
        </div>

        <form action="https://formspree.io/f/xbddooda" method="POST">
          <div class="field-group">
            <label for="name">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              Nombre
            </label>
            <input
              type="text"
              name="name"
              id="name"
              autocomplete="name"
              placeholder="Tu nombre"
              required
            />
          </div>

          <div class="field-group">
            <label for="email">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              Email
            </label>
            <input
              type="email"
              name="email"
              id="email"
              autocomplete="email"
              placeholder="tu@email.com"
              required
            />
          </div>

          <div class="field-group">
            <label for="message">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              Proyecto
            </label>
            <textarea
              name="message"
              id="message"
              rows="5"
              placeholder="Cuéntame qué necesitas construir, mejorar o automatizar."
              required></textarea>
          </div>

          <button type="submit" class="button-primary contact-submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 5vw, 5rem);
    align-items: start;
  }

  .contact-copy {
    display: grid;
    gap: 1.5rem;
  }

  .contact-copy .section-header {
    margin-bottom: 0;
  }

  .contact-copy :global(.button-row) {
    gap: 0.9rem;
  }

  .contact-copy :global(.button-primary),
  .contact-copy :global(.button-secondary) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .contact-links {
    display: grid;
    gap: 0;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-line);
    border-radius: 1.2rem;
    overflow: hidden;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.03),
      rgba(255, 255, 255, 0.01)
    );
  }

  .contact-link-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--color-line);
    transition:
      background var(--transition-base),
      padding-left var(--transition-base);
  }

  .contact-link-item:last-child {
    border-bottom: none;
  }

  .contact-link-item:hover {
    background: rgba(255, 255, 255, 0.03);
    padding-left: 1.4rem;
  }

  .contact-link-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.6rem;
    background: rgba(212, 168, 83, 0.1);
    border: 1px solid rgba(212, 168, 83, 0.15);
    color: var(--color-accent);
  }

  .contact-link-item__content {
    display: grid;
    gap: 0.2rem;
  }

  .contact-link-item__content span {
    font-size: 0.68rem;
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .contact-link-item__content a {
    color: var(--color-text);
    font-size: 0.9rem;
    width: fit-content;
    transition: color var(--transition-base);
  }

  .contact-link-item:hover .contact-link-item__content a {
    color: var(--color-accent-strong);
  }

  .contact-link-item__arrow {
    color: var(--color-text-soft);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
  }

  .contact-link-item:hover .contact-link-item__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Ensure form is always visible even if reveal animation hasn't fired */
  .reveal-form {
    opacity: 1 !important;
    transform: none !important;
  }

  /* Form */
  .contact-form-wrap {
    position: relative;
  }

  .contact-form-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, rgba(212, 168, 83, 0.08) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .contact-form {
    position: relative;
    padding: 1.8rem;
    border-radius: 1.8rem;
    z-index: 1;
    pointer-events: none;
  }

  .contact-form > * {
    position: relative;
    z-index: 1;
    pointer-events: auto;
  }

  .contact-form__header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .contact-form__header h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }

  .contact-form__header p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .contact-form form {
    display: grid;
    gap: 1.1rem;
  }

  .field-group {
    display: grid;
    gap: 0.5rem;
  }

  .field-group label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--color-text-soft);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .field-group label svg {
    color: var(--color-accent);
    opacity: 0.7;
  }

  .field-group input,
  .field-group textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.9rem;
    padding: 0.85rem 1rem;
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.03);
    font: inherit;
    font-size: 0.92rem;
    transition:
      border-color var(--transition-base),
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  .field-group input::placeholder,
  .field-group textarea::placeholder {
    color: var(--color-text-soft);
    opacity: 0.5;
  }

  .field-group input:focus,
  .field-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background: rgba(212, 168, 83, 0.03);
    box-shadow: 0 0 0 3px rgba(212, 168, 83, 0.1);
  }

  .field-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>

<script>
  const contactObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          contactObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.14, rootMargin: "0px 0px -50px 0px" },
  );

  document.querySelectorAll("#contacto .reveal, #contacto .reveal-form").forEach((element) => {
    contactObserver.observe(element);
  });

  // Form submit with fetch (no page redirect)
  const contactForm = document.querySelector("#contacto form");
  const btn = contactForm?.querySelector(".contact-submit");

  if (contactForm && btn instanceof HTMLButtonElement) {
    const originalHTML = btn.innerHTML;

    contactForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation: spin 1s linear infinite;">
          <line x1="12" y1="2" x2="12" y2="6"/>
          <line x1="12" y1="18" x2="12" y2="22"/>
          <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/>
          <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
          <line x1="2" y1="12" x2="6" y2="12"/>
          <line x1="18" y1="12" x2="22" y2="12"/>
          <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/>
          <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
        </svg>
        Enviando...
      `;
      btn.disabled = true;

      const formData = new FormData(contactForm as HTMLFormElement);
      try {
        const res = await fetch(contactForm.getAttribute("action") || "", {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          contactForm.innerHTML = `
            <div style="text-align:center;padding:2rem 1rem;">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 1rem">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <h3 style="margin:0 0 0.5rem;font-family:var(--font-display);font-size:1.3rem">Mensaje enviado</h3>
              <p style="margin:0;color:var(--color-text-muted);font-size:0.9rem">Te respondo en menos de 24 horas.</p>
            </div>
          `;
        } else {
          throw new Error("Server error");
        }
      } catch {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
        alert("No se pudo enviar. Intenta por WhatsApp o email directo.");
      }
    });
  }
</script>

<style is:global>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

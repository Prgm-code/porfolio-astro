---
import { getData, getUi, type Lang } from "../i18n";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);
const { social } = getData(lang);
const email = social.email.replace(/^mailto:/, "");
const display = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");

const arrow = "M7 17 17 7M8 7h9v9";
---

<section id="contacto" class="page-section contact">
  <div class="section-inner">
    <SectionHeader index="05" title={ui.contact.title} />

    <div class="contact-grid">
      <div class="contact-copy reveal">
        <ul class="channels">
          <li class="channel">
            <span class="channel__label">WhatsApp</span>
            <a
              class="channel__value"
              href={social.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
            >
              {ui.contact.whatsappCta}
              <svg
                aria-hidden="true"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="square"><path d={arrow}></path></svg
              >
            </a>
          </li>
          <li class="channel">
            <span class="channel__label">Email</span>
            <a class="channel__value" href={social.email}>{email}</a>
            <button
              type="button"
              class="channel__copy"
              data-copy={email}
              data-copied={ui.contact.copied}
              aria-label={ui.contact.copyEmailLabel}
              hidden
            >
              {ui.contact.copyEmail}
            </button>
          </li>
          <li class="channel">
            <span class="channel__label">LinkedIn</span>
            <a
              class="channel__value"
              href={social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              {display(social.linkedin)}
              <svg
                aria-hidden="true"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="square"><path d={arrow}></path></svg
              >
            </a>
          </li>
          <li class="channel">
            <span class="channel__label">GitHub</span>
            <a
              class="channel__value"
              href={social.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              {display(social.github)}
              <svg
                aria-hidden="true"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="square"><path d={arrow}></path></svg
              >
            </a>
          </li>
        </ul>
        <span class="sr-only" aria-live="polite" data-copy-status></span>
      </div>

      <div class="contact-form reveal">
        <div class="form-card">
          <span class="form-card__bar" aria-hidden="true"></span>
          <p class="form-card__title" id="contact-form-title">
            <span class="form-card__mark" aria-hidden="true"></span>
            {ui.contact.formTitle}
          </p>
          <form
            action="https://formspree.io/f/xbddooda"
            method="POST"
            aria-labelledby="contact-form-title"
            data-sending={ui.contact.sending}
            data-success-title={ui.contact.successTitle}
            data-success-text={ui.contact.successText}
            data-error={ui.contact.errorText}
          >
            <div class="field-row">
              <div class="field-group">
                <label for="name">{ui.contact.labelName}</label>
                <input
                  type="text"
                  name="name"
                  id="name"
                  autocomplete="name"
                  placeholder={ui.contact.placeholderName}
                  required
                />
              </div>

              <div class="field-group">
                <label for="email">{ui.contact.labelEmail}</label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  autocomplete="email"
                  placeholder={ui.contact.placeholderEmail}
                  required
                />
              </div>
            </div>

            <div class="field-group">
              <label for="message">{ui.contact.labelProject}</label>
              <textarea
                name="message"
                id="message"
                rows="5"
                placeholder={ui.contact.placeholderProject}
                required></textarea>
            </div>

            <button
              type="submit"
              class="contact-button contact-button--solid contact-submit"
            >
              <span class="contact-submit__spinner" aria-hidden="true"></span>
              <span data-submit-label>{ui.contact.submit}</span>
              <svg
                class="contact-submit__icon"
                aria-hidden="true"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="square"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </button>

            <div
              id="form-status"
              class="form-status"
              role="status"
              aria-live="polite"
              tabindex="-1"
              hidden
            >
              <strong data-status-title></strong>
              <span data-status-message></span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Misma paleta que el resto de la página */
  .contact {
    --color-inverse-bg: var(--color-bg);
    --color-inverse-text: var(--color-text);
    --color-inverse-muted: var(--color-text-muted);
    --color-inverse-line: var(--color-line);
    --color-inverse-accent: var(--color-accent);
    color: var(--color-text);
  }

  /* Canales: filas de una ficha, etiqueta a la izquierda */
  .channels {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .channel {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .channel__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  .channel__value {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    padding-block: 0.6rem;
    font-weight: 500;
    overflow-wrap: anywhere;
    transition: color var(--transition-base);
  }

  .channel__value svg {
    flex-shrink: 0;
    color: var(--color-text-soft);
    transition:
      transform var(--transition-base),
      color var(--transition-base);
  }

  .channel__value:hover,
  .channel__value:focus-visible {
    color: var(--color-accent);
  }

  .channel__value:hover svg,
  .channel__value:focus-visible svg {
    color: currentColor;
    transform: translate(2px, -2px);
  }

  .channel__copy {
    min-height: 2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition:
      color var(--transition-base),
      border-color var(--transition-base);
  }

  .channel__copy:hover,
  .channel__copy:focus-visible {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .channel__copy.is-done {
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .contact :focus-visible {
    outline-color: var(--color-inverse-accent);
  }

  .contact-grid {
    display: grid;
    gap: 3.5rem;
    margin-top: 0;
  }

  .contact-copy {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  /* Botones sobre fondo oscuro */
  .contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid var(--color-inverse-text);
    background: transparent;
    color: var(--color-inverse-text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--transition-base),
      color var(--transition-base),
      border-color var(--transition-base);
  }

  .contact-button:hover,
  .contact-button:focus-visible {
    background: var(--color-inverse-text);
    color: var(--color-inverse-bg);
  }

  .contact-button--solid {
    background: var(--color-inverse-text);
    color: var(--color-inverse-bg);
  }

  .contact-button--solid:hover,
  .contact-button--solid:focus-visible {
    background: var(--color-inverse-accent);
    border-color: var(--color-inverse-accent);
    color: var(--color-inverse-bg);
  }

  /* Canales */

  /* Formulario: tarjeta translúcida con borde fino */
  .contact-form {
    display: grid;
    align-content: start;
  }

  .form-card {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-surface) 70%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: border-color 300ms var(--ease-out);
  }

  .form-card:focus-within {
    border-color: color-mix(
      in oklab,
      var(--color-line-strong) 35%,
      var(--color-line)
    );
  }

  /* Barra de acento: corta en reposo, completa mientras se escribe */
  .form-card__bar {
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0.12);
    transform-origin: left;
    transition: transform 700ms var(--ease-out);
  }

  .form-card:focus-within .form-card__bar {
    transform: scaleX(1);
  }

  .form-card__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  .form-card__mark {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-accent);
  }

  form {
    display: grid;
    gap: 1.75rem;
  }

  .field-row {
    display: grid;
    gap: 1.75rem;
  }

  .field-group {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-size: 0.875rem;
    color: var(--color-inverse-muted);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.6rem 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
    color: var(--color-inverse-text);
    font: inherit;
    font-size: 1.05rem;
    transition: border-color var(--transition-base);
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-text-soft);
  }

  input:hover,
  textarea:hover {
    border-bottom-color: var(--color-inverse-muted);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--color-inverse-accent);
    box-shadow: 0 1px 0 0 var(--color-inverse-accent);
  }

  .contact-submit {
    justify-self: start;
    min-width: 12rem;
  }

  .contact-submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .contact-submit__spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .contact-submit.is-sending .contact-submit__spinner {
    display: inline-block;
  }

  .contact-submit.is-sending .contact-submit__icon {
    display: none;
  }

  @media (min-width: 720px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--page-gutter);
    }

    .contact-copy {
      grid-column: 1 / span 5;
    }

    .contact-form {
      grid-column: 7 / span 6;
    }
  }
</style>

<script>
  // Copiar el email al portapapeles (solo si el navegador lo permite).
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");

  if (copyButton && navigator.clipboard) {
    const label = copyButton.textContent?.trim() ?? "";
    const copied = copyButton.dataset.copied ?? "";
    let resetTimer = 0;
    copyButton.hidden = false;

    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.copy ?? "");
        copyButton.textContent = copied;
        copyButton.classList.add("is-done");
        if (copyStatus) copyStatus.textContent = copied;
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          copyButton.textContent = label;
          copyButton.classList.remove("is-done");
          if (copyStatus) copyStatus.textContent = "";
        }, 2000);
      } catch {
        copyButton.hidden = true;
      }
    });
  }

  // Form submit with fetch (no page redirect)
  const contactForm = document.querySelector<HTMLFormElement>("#contacto form");
  const btn = contactForm?.querySelector(".contact-submit");
  const submitLabel = btn?.querySelector("[data-submit-label]");
  const status = contactForm?.querySelector("#form-status");
  const statusTitle = status?.querySelector("[data-status-title]");
  const statusMessage = status?.querySelector("[data-status-message]");

  if (
    contactForm &&
    btn instanceof HTMLButtonElement &&
    submitLabel instanceof HTMLElement &&
    status instanceof HTMLElement &&
    statusTitle instanceof HTMLElement &&
    statusMessage instanceof HTMLElement
  ) {
    const formStatus = status;
    const formStatusTitle = statusTitle;
    const formStatusMessage = statusMessage;
    const originalLabel = submitLabel.textContent || "";
    const {
      sending = "Enviando...",
      successTitle = "Mensaje enviado",
      successText = "",
      error = "No se pudo enviar.",
    } = contactForm.dataset;

    function showStatus(
      kind: "success" | "error",
      title: string,
      message: string,
    ) {
      formStatus.hidden = false;
      formStatus.className =
        kind === "error" ? "form-status form-status--error" : "form-status";
      formStatus.setAttribute("role", kind === "error" ? "alert" : "status");
      formStatus.setAttribute(
        "aria-live",
        kind === "error" ? "assertive" : "polite",
      );
      formStatusTitle.textContent = title;
      formStatusMessage.textContent = message;
      formStatus.focus();
    }

    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      formStatus.hidden = true;
      formStatusTitle.textContent = "";
      formStatusMessage.textContent = "";
      contactForm.setAttribute("aria-busy", "true");
      btn.disabled = true;
      btn.classList.add("is-sending");
      submitLabel.textContent = sending;

      const formData = new FormData(contactForm);
      try {
        const response = await fetch(contactForm.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (!response.ok) throw new Error("Server error");
        contactForm.reset();
        showStatus("success", successTitle, successText);
      } catch {
        showStatus("error", error, "");
      } finally {
        contactForm.setAttribute("aria-busy", "false");
        btn.disabled = false;
        btn.classList.remove("is-sending");
        submitLabel.textContent = originalLabel;
      }
    });
  }
</script>

<style is:global>
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

---
import GitHubIcon from "../icons/GitHub.svg?raw";
import LinkedInIcon from "../icons/LinkedIn.svg?raw";
import MailIcon from "../icons/Mail.svg?raw";
import WhatsAppIcon from "../icons/WhatsApp.svg?raw";
---

<section id="contacto" class="py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <h2 class="section-title animate">Contacto</h2>

    <p
      class="animate animate-delay-100 text-center text-[var(--color-text-secondary)] text-lg mb-12 max-w-2xl mx-auto"
    >
      ¿Tienes un proyecto en mente? Estoy disponible para nuevas oportunidades y
      colaboraciones. ¡Hablemos!
    </p>

    <!-- Contact Form -->
    <div class="glass-card p-8 animate animate-delay-200">
      <form
        class="space-y-6"
        action="https://formspree.io/f/xbddooda"
        method="POST"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Name -->
          <div class="relative">
            <input
              type="text"
              name="name"
              id="name"
              required
              class="peer w-full bg-transparent border border-[var(--color-card-border)] rounded-lg px-4 py-3 text-white placeholder-transparent focus:outline-none focus:border-[var(--color-primary)] transition-colors"
              placeholder="Tu Nombre"
            />
            <label
              for="name"
              class="absolute left-4 -top-2.5 bg-[var(--color-bg-secondary)] px-1 text-sm text-[var(--color-text-secondary)] transition-all peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-placeholder-shown:bg-transparent peer-focus:-top-2.5 peer-focus:text-sm peer-focus:text-[var(--color-primary)] peer-focus:bg-[var(--color-bg-secondary)]"
            >
              Tu Nombre
            </label>
          </div>

          <!-- Email -->
          <div class="relative">
            <input
              type="email"
              name="email"
              id="email"
              required
              class="peer w-full bg-transparent border border-[var(--color-card-border)] rounded-lg px-4 py-3 text-white placeholder-transparent focus:outline-none focus:border-[var(--color-primary)] transition-colors"
              placeholder="Tu Email"
            />
            <label
              for="email"
              class="absolute left-4 -top-2.5 bg-[var(--color-bg-secondary)] px-1 text-sm text-[var(--color-text-secondary)] transition-all peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-placeholder-shown:bg-transparent peer-focus:-top-2.5 peer-focus:text-sm peer-focus:text-[var(--color-primary)] peer-focus:bg-[var(--color-bg-secondary)]"
            >
              Tu Email
            </label>
          </div>
        </div>

        <!-- Subject -->
        <!-- <div class="relative">
          <input
            type="text"
            name="subject"
            id="subject"
            required
            class="peer w-full bg-transparent border border-[var(--color-card-border)] rounded-lg px-4 py-3 text-white placeholder-transparent focus:outline-none focus:border-[var(--color-primary)] transition-colors"
            placeholder="Asunto"
          />
          <label
            for="subject"
            class="absolute left-4 -top-2.5 bg-[var(--color-bg-secondary)] px-1 text-sm text-[var(--color-text-secondary)] transition-all peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-placeholder-shown:bg-transparent peer-focus:-top-2.5 peer-focus:text-sm peer-focus:text-[var(--color-primary)] peer-focus:bg-[var(--color-bg-secondary)]"
          >
            Asunto
          </label>
        </div> -->

        <!-- Message -->
        <div class="relative">
          <textarea
            name="message"
            id="message"
            rows="5"
            required
            class="peer w-full bg-transparent border border-[var(--color-card-border)] rounded-lg px-4 py-3 text-white placeholder-transparent focus:outline-none focus:border-[var(--color-primary)] transition-colors resize-none"
            placeholder="Tu Mensaje"></textarea>
          <label
            for="message"
            class="absolute left-4 -top-2.5 bg-[var(--color-bg-secondary)] px-1 text-sm text-[var(--color-text-secondary)] transition-all peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-placeholder-shown:bg-transparent peer-focus:-top-2.5 peer-focus:text-sm peer-focus:text-[var(--color-primary)] peer-focus:bg-[var(--color-bg-secondary)]"
          >
            Tu Mensaje
          </label>
        </div>

        <!-- Submit Button -->
        <div class="text-center">
          <button type="submit" class="btn-primary px-8 py-3 text-base">
            Enviar Mensaje
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Social Links -->
    <div
      class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4 animate animate-delay-300"
    >
      <a
        href="https://www.linkedin.com/in/prgm/"
        target="_blank"
        rel="noopener noreferrer"
        class="glass-card p-4 text-center group"
      >
        <span
          class="w-8 h-8 mx-auto mb-2 text-[#0A66C2] group-hover:scale-110 transition-transform flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"
          set:html={LinkedInIcon}
        />
        <span class="text-sm text-[var(--color-text-secondary)]">LinkedIn</span>
      </a>

      <a
        href="https://www.github.com/prgm-code"
        target="_blank"
        rel="noopener noreferrer"
        class="glass-card p-4 text-center group"
      >
        <span
          class="w-8 h-8 mx-auto mb-2 text-white group-hover:scale-110 transition-transform flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"
          set:html={GitHubIcon}
        />
        <span class="text-sm text-[var(--color-text-secondary)]">GitHub</span>
      </a>

      <a
        href="mailto:contacto@prgm.cl"
        class="glass-card p-4 text-center group"
      >
        <span
          class="w-8 h-8 mx-auto mb-2 text-[#EA4335] group-hover:scale-110 transition-transform flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"
          set:html={MailIcon}
        />
        <span class="text-sm text-[var(--color-text-secondary)]">Email</span>
      </a>

      <a
        href="https://wa.me/56976990163?text=Hola%20Patricio,%20quisiera%20contactarte"
        target="_blank"
        rel="noopener noreferrer"
        class="glass-card p-4 text-center group"
      >
        <span
          class="w-8 h-8 mx-auto mb-2 text-[#25D366] group-hover:scale-110 transition-transform flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"
          set:html={WhatsAppIcon}
        />
        <span class="text-sm text-[var(--color-text-secondary)]">WhatsApp</span>
      </a>
    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("show");
      }
    });
  }, observerOptions);

  document.querySelectorAll("#contacto .animate").forEach((el) => {
    observer.observe(el);
  });
</script>

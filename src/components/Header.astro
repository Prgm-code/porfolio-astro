---
import {
  alternateUrls,
  getUi,
  localePath,
  localeSectionPath,
  type Lang,
} from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = getUi(lang);

const homePath = localePath(lang, "/");
const normalizeForComparison = (path: string) => path.replace(/\/+$/, "");
const isHome =
  normalizeForComparison(Astro.url.pathname) ===
  normalizeForComparison(homePath);

const navItems = [
  { section: "proyectos", label: ui.nav.projects },
  { section: "experiencia", label: ui.nav.experience },
  { section: "stack", label: ui.nav.stack },
  { section: "perfil", label: ui.nav.profile },
  { section: "contacto", label: ui.nav.contact },
].map((item) => ({
  ...item,
  href: isHome ? `#${item.section}` : localeSectionPath(lang, item.section),
}));

const alternates = alternateUrls(Astro.url.pathname);
---

<header id="site-header" class="site-header">
  <div class="header-inner">
    <a
      href={isHome ? "#hero" : homePath}
      class="site-mark"
      aria-label={ui.nav.ariaHome}
    >
      <span class="site-mark__square" aria-hidden="true"></span>
      <span class="site-mark__name">prgm.cl</span>
    </a>

    <nav class="header-nav" aria-label={ui.nav.ariaMain}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-pressed="false"
        aria-label={ui.nav.themeLabel}
        title={ui.nav.themeLabel}
      >
        <svg
          class="theme-toggle__sun"
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="square"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg
          class="theme-toggle__moon"
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="square"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>
      <div class="lang-toggle" role="group" aria-label={ui.nav.languageLabel}>
        <a
          href={alternates.es}
          class:list={["lang-toggle__option", lang === "es" && "is-active"]}
          aria-current={lang === "es" ? "true" : undefined}
          data-lang-choice="es">ES</a
        >
        <a
          href={alternates.en}
          class:list={["lang-toggle__option", lang === "en" && "is-active"]}
          aria-current={lang === "en" ? "true" : undefined}
          data-lang-choice="en">EN</a
        >
      </div>
    </div>

    <div class="mobile-actions">
      <button
        type="button"
        class="theme-toggle theme-toggle--compact"
        data-theme-toggle
        aria-pressed="false"
        aria-label={ui.nav.themeLabel}
        title={ui.nav.themeLabel}
      >
        <svg
          class="theme-toggle__sun"
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="square"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg
          class="theme-toggle__moon"
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="square"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="mobile-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={ui.nav.ariaOpenMenu}
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <dialog id="mobile-nav" class="mobile-nav" aria-label={ui.nav.ariaMobile}>
    <div class="mobile-nav__bg" aria-hidden="true"></div>
    <nav aria-label={ui.nav.ariaMobile}>
      <div class="mobile-nav__header">
        <span class="mobile-nav__brand">prgm.cl</span>
        <button
          id="mobile-menu-close"
          type="button"
          class="mobile-close"
          aria-label={ui.nav.ariaCloseMenu}
        >
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="square"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="mobile-nav__links">
        {
          navItems.map((item) => (
            <a href={item.href} class="mobile-link">
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="mobile-nav__footer">
        <div
          class="lang-toggle lang-toggle--mobile"
          role="group"
          aria-label={ui.nav.languageLabel}
        >
          <a
            href={alternates.es}
            class:list={["lang-toggle__option", lang === "es" && "is-active"]}
            aria-current={lang === "es" ? "true" : undefined}
            data-lang-choice="es">ES</a
          >
          <a
            href={alternates.en}
            class:list={["lang-toggle__option", lang === "en" && "is-active"]}
            aria-current={lang === "en" ? "true" : undefined}
            data-lang-choice="en">EN</a
          >
        </div>
      </div>
    </nav>
  </dialog>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-header-bg);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-base);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-line);
  }

  .header-inner {
    width: min(100% - var(--page-gutter) * 2, var(--content-width));
    height: var(--header-height);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Marca */
  .site-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
  }

  .site-mark__square {
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-accent);
    transition: transform var(--transition-base);
  }

  .site-mark__name {
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.015em;
  }

  /* Navegación */
  .header-nav {
    display: none;
  }

  .header-nav ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding-block: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    transition: color var(--transition-base);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-ink);
  }

  /* Acciones */
  .header-actions {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }

  .lang-toggle {
    display: inline-flex;
    border: 1px solid var(--color-line);
  }

  .lang-toggle__option {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    min-height: 2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-soft);
    transition:
      color var(--transition-base),
      background-color var(--transition-base);
  }

  .lang-toggle__option:hover {
    color: var(--color-ink);
  }

  .lang-toggle__option.is-active {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  /* Tema */
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color var(--transition-base),
      color var(--transition-base);
  }

  .theme-toggle:hover {
    border-color: var(--color-ink);
    color: var(--color-accent);
  }

  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      transform 500ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }

  .theme-toggle__moon,
  :global([data-theme="dark"]) .theme-toggle__sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global([data-theme="dark"]) .theme-toggle__moon {
    opacity: 1;
    transform: none;
  }

  .theme-toggle--compact {
    width: 2.75rem;
    height: 2.75rem;
  }

  .mobile-actions {
    display: flex;
    gap: 0.5rem;
  }

  /* Toggle móvil */
  .mobile-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.6rem;
    background: transparent;
    border: 1px solid var(--color-line);
    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;
    height: 1.5px;
    background: var(--color-ink);
  }

  .mobile-toggle span:last-child {
    width: 60%;
    margin-left: auto;
  }

  @media (min-width: 1081px) {
    .header-nav,
    .header-actions {
      display: flex;
    }

    .mobile-actions {
      display: none;
    }
  }

  /* Menú móvil (dialog) */
  .mobile-nav {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-inverse-text);
  }

  .mobile-nav::backdrop {
    background: transparent;
  }

  .mobile-nav[open] {
    display: block;
  }

  .mobile-nav__bg {
    position: fixed;
    inset: 0;
    background: var(--color-inverse-bg);
  }

  .mobile-nav nav {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0 var(--page-gutter) 2rem;
  }

  .mobile-nav__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    border-bottom: 1px solid var(--color-inverse-line);
  }

  .mobile-nav__brand {
    font-weight: 600;
    color: var(--color-inverse-muted);
  }

  .mobile-close {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid var(--color-inverse-line);
    color: var(--color-inverse-text);
    cursor: pointer;
  }

  .mobile-nav__links {
    display: flex;
    flex-direction: column;
    padding-block: 1.5rem;
  }

  .mobile-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-inverse-line);
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .mobile-nav__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .lang-toggle--mobile {
    border-color: var(--color-inverse-line);
  }

  .lang-toggle--mobile .lang-toggle__option {
    min-height: 2.75rem;
    min-width: 2.75rem;
    color: var(--color-inverse-muted);
  }

  .lang-toggle--mobile .lang-toggle__option.is-active {
    background: var(--color-inverse-text);
    color: var(--color-inverse-bg);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const menuButton = document.getElementById("mobile-menu-toggle");
  const closeButton = document.getElementById("mobile-menu-close");
  const mobileNav = document.getElementById("mobile-nav");
  const mobileLinks = document.querySelectorAll(
    ".mobile-link, .mobile-nav [data-lang-choice]",
  );

  function updateHeaderState() {
    if (!header) return;
    header.classList.toggle("is-scrolled", window.scrollY > 24);
  }

  function closeMenu({ restoreFocus = true } = {}) {
    if (
      !header ||
      !(menuButton instanceof HTMLButtonElement) ||
      !(mobileNav instanceof HTMLDialogElement)
    ) {
      return;
    }

    if (mobileNav.open) mobileNav.close();
    header.classList.remove("menu-active");
    menuButton.setAttribute("aria-expanded", "false");
    document.body.classList.remove("menu-open");
    if (restoreFocus) menuButton.focus();
  }

  function openMenu() {
    if (
      !header ||
      !(menuButton instanceof HTMLButtonElement) ||
      !(mobileNav instanceof HTMLDialogElement)
    ) {
      return;
    }

    if (!mobileNav.open) mobileNav.showModal();
    header.classList.add("menu-active");
    menuButton.setAttribute("aria-expanded", "true");
    document.body.classList.add("menu-open");
    if (closeButton instanceof HTMLButtonElement) closeButton.focus();
  }

  function toggleMenu() {
    if (!(mobileNav instanceof HTMLDialogElement)) return;
    if (mobileNav.open) closeMenu();
    else openMenu();
  }

  window.addEventListener("scroll", updateHeaderState, { passive: true });
  window.addEventListener("resize", () => {
    if (window.innerWidth > 1080) closeMenu({ restoreFocus: false });
  });
  menuButton?.addEventListener("click", toggleMenu);
  closeButton?.addEventListener("click", () => closeMenu());
  mobileLinks.forEach((link) =>
    link.addEventListener("click", () => closeMenu({ restoreFocus: false })),
  );
  mobileNav?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeMenu();
  });
  mobileNav?.addEventListener("click", (event) => {
    if (
      event.target === mobileNav ||
      (event.target instanceof Element &&
        event.target.classList.contains("mobile-nav__bg"))
    ) {
      closeMenu();
    }
  });
  updateHeaderState();

  // Persistir la elección y conservar la sección al cambiar de idioma.
  document
    .querySelectorAll<HTMLAnchorElement>("[data-lang-choice]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        const choice = link.dataset.langChoice;
        try {
          if (choice) localStorage.setItem("prgm:lang", choice);
        } catch {}

        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        event.preventDefault();
        const destination = new URL(link.href, window.location.href);
        destination.hash = window.location.hash;
        window.location.assign(
          `${destination.pathname}${destination.search}${destination.hash}`,
        );
      });
    });

  // Modo claro/oscuro con revelado circular (View Transitions API).
  const themeToggles = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  function syncThemeToggles() {
    const isDark = document.documentElement.dataset.theme === "dark";
    themeToggles.forEach((toggle) =>
      toggle.setAttribute("aria-pressed", String(isDark)),
    );
  }

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem("prgm:theme", theme);
    } catch {}
    syncThemeToggles();
  }

  themeToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const next =
        document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (!document.startViewTransition || reducedMotion) {
        applyTheme(next);
        return;
      }

      const rect = toggle.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const radius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );

      const transition = document.startViewTransition(() => applyTheme(next));
      transition.ready.then(() => {
        document.documentElement.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${radius}px at ${x}px ${y}px)`,
            ],
          },
          {
            duration: 620,
            easing: "cubic-bezier(0.65, 0, 0.35, 1)",
            pseudoElement: "::view-transition-new(root)",
          },
        );
      });
    });
  });

  syncThemeToggles();

  document.addEventListener("astro:before-swap", () => {
    window.removeEventListener("scroll", updateHeaderState);
  });
</script>
